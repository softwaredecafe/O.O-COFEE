                <div class="modal-controls" bis_skin_checked="1">
                    <div style="text-align: left;" bis_skin_checked="1">
                        <a id="aHelpBack" href="https://57906.lightfolio.com/gallery/tazas-endiabladas-con-teco/grODNb0A#" onclick="helpBack(); return false;" style="display: none; color: rgb(170, 170, 170); --darkreader-inline-color: var(--darkreader-text-aaaaaa, #b2aca2);" data-darkreader-inline-color="">Back</a>
                    </div>
                    <div bis_skin_checked="1">
                        <a id="aHelpNext" href="https://57906.lightfolio.com/gallery/tazas-endiabladas-con-teco/grODNb0A#" onclick="helpNext(); return false;" style="color: rgb(34, 34, 34); --darkreader-inline-color: var(--darkreader-text-222222, #d3cfc9);" data-darkreader-inline-color="">Next</a>
                        <a id="aHelpClose" href="https://57906.lightfolio.com/gallery/tazas-endiabladas-con-teco/grODNb0A#" onclick="closeModal(this);; return false;" style="color: rgb(34, 34, 34); display: none; --darkreader-inline-color: var(--darkreader-text-222222, #d3cfc9);" data-darkreader-inline-color="">Close</a>
