.cover-title > div { font-family: Raleway; font-weight: 700; font-style: normal; font-size: 16px; letter-spacing: 2px; text-decoration: none; text-transform: uppercase; line-height: 1.2; text-shadow: none; }
.cover-title > div { color: rgb(170, 170, 170); }
.cover-title img { width: 180px; }
.cover-content-block { }
.cover-headline { font-family: Raleway; font-weight: 700; font-style: normal; font-size: 53px; letter-spacing: 2px; text-decoration: none; text-transform: uppercase; line-height: 1.2; text-shadow: rgb(136, 136, 136) 1px 1px 1px; }
.cover-headline { color: rgb(255, 255, 255); }
.cover-body, .cover-body p { font-family: Raleway; font-weight: 400; font-style: normal; font-size: 14px; letter-spacing: 2px; text-decoration: none; text-transform: none; line-height: 1.2; text-shadow: none; }
.cover-body, .cover-body p { color: rgb(255, 255, 255); }
.cover-button { border-radius: 3px; }
.cover-button { border-color: rgb(255, 255, 255); }
.cover-button { background-color: rgb(255, 255, 255); }
.cover-button { font-family: Raleway; font-weight: 400; font-style: normal; font-size: 12px; letter-spacing: 2px; text-decoration: none; text-transform: uppercase; line-height: 1.2; text-shadow: none; }
.cover-button { color: rgb(34, 34, 34); }
.social-icons a { color: rgb(170, 170, 170); }
@media (max-width: 1200px) {
  .cover-button { font-size: 9px; line-height: 1.2; }
}
@media (max-width: 900px) {
  .cover-button { font-size: 9px; line-height: 1.2; }
}
@media (max-width: 480px) {
  .cover-button { font-size: 9px; line-height: 1.2; }
}
@media (max-width: 1200px) {
  .cover-body, .cover-body p { font-size: 10.5px; line-height: 1.2; }
}
@media (max-width: 900px) {
  .cover-body, .cover-body p { font-size: 9px; line-height: 1.2; }
}
@media (max-width: 480px) {
  .cover-body, .cover-body p { font-size: 9px; line-height: 1.2; }
}
@media (max-width: 1200px) {
  .cover-headline { font-size: 39.75px; line-height: 1.2; }
}
@media (max-width: 900px) {
  .cover-headline { font-size: 31.8px; line-height: 1.2; }
}
@media (max-width: 480px) {
  .cover-headline { font-size: 24px; line-height: 1.2; }
}
@media (max-width: 1200px) {
  .cover-title > div { font-size: 12px; line-height: 1.2; }
}
@media (max-width: 900px) {
  .cover-title > div { font-size: 9.6px; line-height: 1.2; }
}
@media (max-width: 480px) {
  .cover-title > div { font-size: 9px; line-height: 1.2; }
