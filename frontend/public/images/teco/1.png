        <script type="text/javascript">
            var lastHelpItem = 0;
            var helpInitialized = false;

            var transComments = 'Comments';
            var transFavorites = 'Favorites';
            var transDownload = 'Download';
            var transBuy = 'Buy';
            var transHide = 'Hide';
            var transLike = 'Like';
            var transShare = 'Share';

            $(document).ready(function () {

                $('.primary-image,.image-left,.image-right,.secondary-image,.tertiary-image').imagesLoaded(
                    { background: true }
                    , function () {
                        $('.primary-image,.image-left,.image-right,.secondary-image,.tertiary-image').addClass('image-loaded');
                    }
                ).fail(function (instance) {
                    //console.log('failed', $(this));
                    CallAjax('Collections_ImageFailed', { collectionsGuid: $('[id$="hfCollectionsGuid"]').val(), fileName: '' }, function () { });
                });

                var wage = document.getElementById("ulComments");
                if (wage) {
                    wage.addEventListener("keydown", function (e) {
                        if (e.code === "Enter") {  //checks whether the pressed key is "Enter"
                            addComment();
                        }
                    });
                }                

                $("body").on("contextmenu", "img", function (e) {
                    return false;
                });

                $('.cover-fade').removeClass('cover-fade');
                $('body').css('position', 'relative');

                $('#divLightbox').load('/gallery/lightbox.aspx', function () { initLightboxes(); });
                bindSpecificSelections();

                lazySizesConfig.expand = 1000; //increase default images loaded
                $('.cover-button').addClass('cover-button-show');
                
                switch(GetQueryString('help')){
                    case 'all':
                        showHelp();
                        break;
                    case 'download':
                        if(typeof(showGallery) == 'function')
                            showGallery();
                        showHelp(1);
                        break;
                    case 'sell':
                        if(typeof(showGallery) == 'function')
                            showGallery();
                        showHelp(2);
                        break;
                    case 'favorites':
                        if(typeof(showGallery) == 'function')
                            showGallery();
                        showHelp(3);
                        break;
                }

                if(GetQueryString('help') == 'true' || $('[id$="hfDisplayHelp"]').val() == 'true'){
                    showHelp();
                    $('[id$="hfDisplayHelp"]').val('false'); //reset
                }       
            });

            function initHelp(){
                $('.help-slides').slick({
                    dots: true,
                    infinite: true,
                    speed: 300,
                    slidesToShow: 1
                }).on('beforeChange', function(event, slick, currentSlide, nextSlide){
                    //console.log(nextSlide);
                    lastHelpItem = currentSlide;
                }).on('afterChange', function(event, slick, currentSlide){
                    if(currentSlide + 1 == slick.slideCount){
                        $('#aHelpNext').hide();
                        $('#aHelpClose').show();
                    }                        
                    else{
                        $('#aHelpNext').show();
                        $('#aHelpClose').hide();
                    }                        

                    if(currentSlide == 0)
                        $('#aHelpBack').hide();
                    else
                        $('#aHelpBack').show();
                });

                helpInitialized = true;
            }

            function showHelp(i){
                $('#divHelp').show();
                if(helpInitialized == false)
                    initHelp();

                stopScrolling();   
                
                i = i || 0;

                $('.help-slides').slick('slickGoTo', i);
                $('#aHelpNext').show();
                $('#aHelpClose').hide();
            }

            //function helpJump(i){
            //    $('.help-slides').slick('slickGoTo', i);
            //}

            function helpBack(){
                var jumpTo = lastHelpItem;

                if(lastHelpItem == -1)
                    jumpTo = $('.help-slides').slick('slickCurrentSlide') - 1; //set to slide before

                $('.help-slides').slick('slickGoTo', jumpTo);
                lastHelpItem = -1; //reset
            }

            function helpNext(){
                $('.help-slides').slick('slickNext');
            }

            function closeModal(m) {
                $(m).closest('.gallery-modal').hide();
                startScrolling();
                singleImagesId = ''; //reset
            }
        </script>

