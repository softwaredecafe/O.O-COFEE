            //        div.find('.details-selected .details-like').removeClass('value');
            //    }
                  
            //    div.find('.stats-likes').toggleClass('value', obj.HasLike);
            //    //$('#aModalLike').toggleClass('value', obj.HasLike);
            //}

            function toggleComments(hide) {
                //console.log($('.details-comments').css('opacity'));
                if ((window.innerWidth || 0) >= 900)
                    $('.details-comments').show();
                else if ($('.details-comments').is(':visible') || hide == true) { //.css('opacity') == 1 || hide == true) {
                    $('.details-comments').hide(); //.css('opacity', 0).css('pointer-events', 'none');
                }
                else {
                    $('.details-comments').show(); //.css('opacity', 1).css('pointer-events', 'all');
                }                
            }

            var scrollPosition = 0;

            function stopScrolling() {
                $('body').addClass("stop-scrolling");
                document.ontouchmove = function (e) {
                    //e.preventDefault();
                }
                //if(scrollPosition == 0){
                //    scrollPosition = $(document).scrollTop();
                //}                
                ////this is not working properly with certain layouts (mason,justified)
                ////see: http://stackoverflow.com/a/24727206
                //$('body').addClass('stop-scrolling');

                //if(/Mobi/i.test(navigator.userAgent) == false) //https://stackoverflow.com/a/24600597
                //    $('body').addClass('stop-scrolling-desktop');
            }

            function startScrolling() {    
                $('body').removeClass('stop-scrolling')
                document.ontouchmove = function (e) {
                    return true;
                }
                //if(anyModalsOpen() == false){
                //    $('body').removeClass('stop-scrolling').removeClass('stop-scrolling-desktop');
                //    $(document).scrollTop(scrollPosition);
                //}                
            }

            function anyModalsOpen(){
                if($('#divModalImage').is(':visible') || $('#divModalCart').is(':visible') || $('#divModalStore').is(':visible')  || $('#divPackagePicker').is(':visible'))
                    return true;
                else
                    return false;
            }

            function showModalImage() {      
                $('.modal-mobile-actions').removeClass('modal-mobile-actions'); //reset
                $('#divModalImage').show();
                //if (window.screen.width > 900)
                //    $('.details-comments').show();
                //else
                //    $('.details-comments').hide();
                toggleComments(true);
                //var offset =  $(window).scrollTop();
                //var height = $(window).height();

                //$('#divModalImage').css('top', offset + 'px').css('height', height + 'px');

                stopScrolling();
            }

            function launchShowLightbox() {
                if (typeof showLightbox === 'function')
                    showLightbox();
            }

//deprecated?
            //function hideImage() {
            //    $('#divModalImage').hide();
            //    toggleAutoplay(true);

            //    if(typeof(pushHistory) == 'function'){
            //        //console.log('hiding image');
            //        pushHistory();
            //    }

            //    if (carouselMode == 'lightbox')
            //        showLightbox();
            //    else 
            //        startScrolling();
            //}

            function openSocialShare(href, s, isImg) {
                var w = s == 'pinterest' ? 800 : 600;
                var h = 500;
                var left = (window.screen.width / 2) - (w / 2);
                var top = (window.screen.height / 3) - (h / 3);

                //if(s == 'facebook'){
                //    $('meta[property="og:image"]').attr('content',href.substring(href.indexOf('u=') + 2).replace('&src=sdkpreparse',''));
                //}                

                window.open(href, s + '-share-window', 'left=' + left + ',top=' + top + ',width=' + w + ',height=' + h + ',toolbar=1,resizable=0')
                logShareClick(s, isImg);
            }

            function logShareClick(s, isImg) {
                if (isImg) {
                    CallAjax('FolderImageActivities_SaveShare', {'collectionsGuid': $('[id$="hfCollectionsGuid"]').val(), 'folderImagesId': $('#ShareFolderImagesId').val(), 'site': s }, function () { });
                }
                else {
                    CallAjax('Folders_SaveShare', { 'collectionsGuid': $('[id$="hfCollectionsGuid"]').val(), 'galleriesGuid': $('[id$="hfFoldersGuid"]').val(), 'site': s }, function () { });
                }
            }
        </script>
        
        

