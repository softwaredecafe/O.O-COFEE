                        <a id="aRevokeLightbox" class="action revoke-lightbox" href="https://57906.lightfolio.com/gallery/tazas-endiabladas-con-teco/grODNb0A#" onclick="revokeLightbox(); return false;" style="display: none;">Edit Favorites</a>
