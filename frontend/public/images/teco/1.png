            <script type="text/javascript">
                function toggleFoldersSelected(){
                    $('#DownloadFolders').val($('#ulDownloadFolders input[type=checkbox]:checked').length);
                }

                function showDownloadGallery(singleImageDownload) {
                    if(vDownload)
                        vDownload.resetForm();

                    $('#DownloadFolders').val('0');

                    var numDownloadableFolders = 0;

                    if ($('[id$="hfDownloadSpecific"]').val() == 'true') {
                        $('#divSelectFolders').hide();
                    }
                    else {
                        $('#ulDownloadFolders').html(''); //reset
                        for (var x = 0; x < allFolders.length; x++) {
                            if (allFolders[x].AllowDownloads && singleImageDownload != true && typeof allFolders != 'undefined') {
                                var id = allFolders[x].FoldersGuid;
                                var disabled = allFolders[x].NumImages > 0 ? '' : ' disabled="disabled" ';
                                $('#ulDownloadFolders').append('<li><input type="checkbox" id="dg-' + id + '"' + disabled + ' value="' + id + '" onclick="toggleFoldersSelected();" /><label for="dg-' + id + '"><i class="fas fa-folder"></i> ' + allFolders[x].FolderName + ' (' + allFolders[x].NumImages + ')</label></li>');
                                numDownloadableFolders++;
                            }
                        }

                        if (typeof lightboxes !== 'undefined') {
                            for (var x = 0; x < lightboxes.length; x++) {
                                if (lightboxes[x].NumImages > 0 && $('[id$="hfAllowFavoritesDownload"]').val() == 'true') {
                                    var id = lightboxes[x].FoldersGuid;
                                    $('#ulDownloadFolders').append('<li><input type="checkbox" id="dg-' + id + '" value="' + id + '" onclick="toggleFoldersSelected();" /><label for="dg-' + id + '"><i class="fas fa-heart"></i> ' + lightboxes[x].FolderName + ' (' + lightboxes[x].NumImages + ')</label></li>');
                                    numDownloadableFolders++;
                                }
                            }
                        }


                        if (numDownloadableFolders == 1) //allFolders.length == 1 
                            $('#ulDownloadFolders input[type=checkbox]').prop('checked', true); //check single folder by default

                        $('#divSelectFolders').toggle(numDownloadableFolders > 1 && singleImageDownload != true); //allFolders.length > 1
                    }

                    $('#AfterPinAction').val('GalleryDownload');

                    if($('[id$="hfPinStatus"]').val() == 'pin required' || $('[id$="hfPinStatus"]').val() == 'pin gallery'){                        
                        cancelDownloadGallery();
                        showPinForm();
                    }                        
                    else{
                        $("#divDownloadStart input").keydown(function (e) {
                            if (e.keyCode == 13 && downloadStarted == false) {
                                downloadStarted = true;
                                continueDownload();
                            }
                        });

                        $('#spnGalleryDownloadInstructions').toggle(GetString(singleImagesId) == '')

                        $('[id$="pnlDownloads"]').show();
                        $('#divDownloadStart').show();
                        $('#divDownloadPreparing').hide();
                        $('#divDownloadReady').hide();
                        $('#divDownloadReadyGoogle').hide();
                        $('#divDownloadDestination').hide();
                        $('#divDownloadIos').hide();
                        $('#divDownloadError').hide();
                        $('.specific-download').hide();
                        //$('#DownloadEmail').focus(); //bad for mobile
                    }                    
                }

                function cancelDownloadGallery(){
                    $('[id$="pnlDownloads"]').hide();
                    singleImagesId = ''; //reset
                    downloadStarted = false; //reset
                }

                var vDownload;
                function validateDownloadGallery(){
                    var msgs = {};
                    var rules = {};

                    $('#DownloadEmail').val($('#DownloadEmail').val().replace(/\s/g, '')); //remove any whitespace

                    msgs.DownloadFolders = {min: 'Please check at least one box.'};
                    msgs.DownloadEmail = { required: 'Email is required.', email: 'Please enter a valid email address.'};

                    if ($('#ulDownloadFolders li').length > 0) {
                        if (allFolders.filter(function (f) { return f.AllowDownloads == true }).length > 1)
                            rules.DownloadFolders = { min: 1 };
                    }    

                    vDownload = $('#divDownloadStart').createValidator(msgs, rules);

                    //if ($('#ulDownloadFolders li').length == 0)
                    //    return true;
                    //else {
                        var valid = RunValidation(vDownload);

                        console.log('validateDownloadGallery', valid);
                        return valid;
                    //}   
                }

                function continueDownload() {
                    if (typeof showDestination === 'function') {
                        if (validateDownloadGallery())
                            showDestination();
                    }
                    else
                        startDownload(1566);
                }

                var singleImagesId;

                function startDownload(t) {
                    downloadRequestTypesId = t;
                    //console.log('startDownload', downloadRequestTypesId);

                    if (GetString(singleImagesId) != '') {
                        //console.log('singleImagesId, starting singleDownload');
                        startSingleDownload();
                    }
                    else if (validateDownloadGallery()) {
                        var l = $('#aStartDownload').ladda();
                        l.ladda('start');

                        if (downloadRequestTypesId == 1566) {
                            var l = $('#bDeliverEmail').ladda();
                            l.ladda('start');
                        }                  

                        var tokensId = downloadRequestTypesId == 1567 ? (googleTokensId || '') : '';

                        if ($('[id$="hfDownloadSpecific"]').val() == 'true') {
                            downloadStarted = true;

                            CallAjax('DownloadRequests_StartSpecific', { collectionsGuid: $('[id$="hfCollectionsGuid"]').val(), emailAddress: $('#DownloadEmail').val(), tokensId: tokensId }, startDownloadSuccess, startDownloadFailed);
                        }
                        else {
                            var folders = [];
                            $('#ulDownloadFolders input[type=checkbox]:checked').each(function (i, v) {
                                folders.push($(v).val());
                            });
                            
                            console.log('tokensId', tokensId);
                            CallAjax('DownloadRequests_Start', { 'collectionsGuid': $('[id$="hfCollectionsGuid"]').val(), 'galleriesGuid': $('[id$="hfFoldersGuid"]').val(), folders: folders, folderImagesId: singleImagesId || '', 'emailAddress': $('#DownloadEmail').val(), tokensId: tokensId }, startDownloadSuccess, startDownloadFailed);
                        }
                    }
                }


                function startDownloadSuccess(results) {
                    var l = $('#aStartDownload').ladda();
                    l.ladda('stop');

                    if (results.TokenFailed) {
                        googleTokensId = ''; //reset
                        toastr.error('Request failed');
                        return;
                    }
                    else if (results.Status == 'queued') {
                        $('#AfterPinAction').val(''); //clear
                        $('#divDownloadStart').hide().clearForm();
                        alert('Your request is already being processed');
                    }
                    else if(results.Status == 'pin required' || results.Status == 'pin gallery'){
                        $('#AfterPinAction').val('GalleryDownload');
                        cancelDownloadGallery();
                        showPinForm();
                    }                        
                    else{
                        $('#AfterPinAction').val(''); //clear
                        $('#divDownloadStart').hide().clearForm();     
                        
                        if(GetString(singleImagesId) != '')
                            startSingleDownload();
                        else {                            
                            $('#spnEmailNotice').toggle(downloadRequestTypesId == 1566);
                            $('#divDownloadPreparing').show();
                            $('#divDownloadDestination').hide();
                            $('#divDownloadReady').hide();
                            $('#divDownloadReadyGoogle').hide();
                            startDownloadProgress(results);
                            downloadStarted = false; //reset
                        }   
                    }                    
                }

                function startDownloadProgress(results) {
                    downloadRequestsGuid = results.DownloadId;

                    if (srConnection && srConnection.state === $.signalR.connectionState.connected) {
                        //nothing to do
                    } else {
                        console.log("SignalR is NOT connected");
                        startSignalr();
                    }

                    //if (srConnection && srConnection.state !== $.signalR.connectionState.connected) {
                    //    //still not connected?
                    //    console.log('SignalR unable to reconnect: ' + srConnection.state + ' vs ' + $.signalR.connectionState.connected);
                    //    numDownloadChecks = 0; //reset
                    //    setTimeout(function () {
                    //        checkDownloadStatus(downloadRequestsGuid); // results.DownloadId);
                    //    }, 2000);
                    //    return;
                    //}

                    //backup check
                    numDownloadChecks = 0; //reset
                    setTimeout(function () {
                        checkDownloadStatus(results.DownloadId);
                    }, 2000);
                }

                function joinGroup() {
                    srHub.invoke('JoinGroup', downloadRequestsGuid) // results.DownloadId)
                        .done(function () {
                            console.log("✅ Successfully joined the group: " + downloadRequestsGuid);
                            $('#divDownloadProgress').hide().html('Processing...'); //reset
                            //var url = 'https://public.lightfolio.com/api/signalr/sendmessage?target=downloadRequestMessage&groupId=' + results.DownloadId + '&json=noway';
                            //$.get(url, function (data, status) {
                            //    console.log('$.get data', data);
                            //}, 'html');
                        })
                        .fail(err => console.error("❌ Join group failed:", err));
                }

                var downloadRequestsGuid;
                var numDownloadChecks = 0;
                function checkDownloadStatus(i) {
                    downloadRequestsGuid = i;
                    numDownloadChecks++;
                    CallAjax('DownloadRequests_GetStatus', { downloadRequestsGuid: i }, checkDownloadStatusSuccess);
                }

                function checkDownloadStatusSuccess(results) {
                    $('#divDownloadProgress').show().html(results.Progress + '% completed');

                    if (results.Progress == 100) {
                        if (results.DownloadRequestTypesId == 1566) {
                            $('#divDownloadPreparing').hide();
                            $('#divDownloadReady').show();
                            //if (/iphone|ipod|ipad/i.test(navigator.userAgent)) //any ios
                            //    $('#pMobileDownloadHelp').show();
                            $('#aDownloadLink').attr('href', results.Link + "?src=g");
                        }
                        else {
                            //$('#divDownloadProgress').show().html('<i class="fal fa-check-circle fa-fw"></i> Your download is ready');
                            $('#divDownloadPreparing').hide();
                            $('#divDownloadReadyGoogle').show();
                        }

                        if (srConnection)
                            srConnection.stop();
                    }
                    else {
                        if (numDownloadChecks < 50) {
                            setTimeout(function () {
                                checkDownloadStatus(downloadRequestsGuid);
                            }, 5000);  //5 sec polling
                        }                        
                    }
                }

                function startDownloadFailed(results) {
                    var l = $('#aStartDownload').ladda();
                    l.ladda('stop');

                    singleImagesId = ''; //reset

                    $('#AfterPinAction').val(''); //clear
                    $('#divDownloadDestination').hide();
                    $('#divDownloadStart').hide();
                    $('#divDownloadError').show();
                    $('#spnDownloadError').html(results.responseJSON.Message);
                }

                var srHub, srConnection;
                async function startSignalr() {

                    return; 

                    srConnection = new signalR.HubConnectionBuilder()
                        .withUrl("https://signal.lightfolio.com/contactHub", {
                            withCredentials: false
                        })
                        .configureLogging(signalR.LogLevel.Information)
                        .build();
                    //srConnection = $.hubConnection("https://public.lightfolio.com/signalr", { useDefaultPath: false });
                    //srHub = srConnection.createHubProxy("contactHubBase");

                    srConnection.on("receiveMessage", function (user, message) {
                        console.log("📩 Message from " + user + ": " + message);
                    });

                    srConnection.on("downloadProgressMessage", function (data, message) {
                        console.log("downloadProgressMessage: " + data + " - " + message);
                        var json = JSON.parse(data);
                        var progress = json.Progress;
                        if (progress == 100) {
                            if (json.DownloadRequestTypesId == 1566) {
                                $('#divDownloadPreparing').hide();
                                $('#divDownloadReady').show();
                                $('#divDownloadReadyGoogle').hide();
                                $('#aDownloadLink').attr('href', json.Link + "?src=g"); //$('#divDownloadProgress').show().html('<a href="' + json.Link + '" target="_blank">Download is ready</a>');
                            }
                            else {
                                //$('#divDownloadProgress').show().html('<i class="fal fa-check-circle fa-fw"></i> Your download is ready');
                                $('#divDownloadPreparing').hide();
                                $('#divDownloadReadyGoogle').show();
                            }       

                            if (srConnection)
                                srConnection.stop();
                        }
                        else
                            $('#divDownloadProgress').show().html(progress + '% completed');
                    });

                    console.log('starting Signalr...');
                    await srConnection.start();
                    //srConnection.start({ jsonp: true, transport: ['webSockets', 'serverSentEvents', 'longPolling'] })
                    //    .done(function () {
                    //        console.log('Signalr connected');
                    //        joinGroup();
                    //    }).fail(function (err) {
                    //        console.error("Connection failed: " + err);
                    //    });

                    srConnection.disconnected(async () => {
                        console.log('Signalr disconnected');
                    });
                }

                //function closeDownloadGallery() {
                //    $('#AfterPinAction').val(''); //clear
                //    $('.lightbox-screen').hide();
                //}
            </script>
        
</div>



         
        <script type="text/javascript">
            //postMessage receiver:
            window.addEventListener("message", function (event) {
                // Ensure the message comes from the expected origin
                if (event.origin === "https://public.lightfolio.com") {
                    console.log('postMessage', event);
                    googlePhotoCallback(event.data);
                }
            });

            var googlePopup;
            function googlePhotosDownload() {
                var l = $('#bDeliverGoogle').ladda();
                l.ladda('start');

                if (googleTokensId) {
                    startDownload(1567);
                    return;
                }

                var popupDimensions = "width=600,height=700";
                if ($(document).width() < 600)
                    popupDimensions = 'width=' + $(document).width() + ',height=' + $(document).height();

                googlePopup = window.open('/gallery/galleryPopup.html', "GoogleAuth", popupDimensions);
                downloadRequestTypesId = 1567;
                CallAjax('FolderImageActivities_ValidateDownload', { 'collectionsGuid': $('[id$="hfCollectionsGuid"]').val(), folderImagesId: singleImagesId || '' }, googlePhotosDownloadSuccess, googlePhotosDownloadFailed);                  
            }

            function googlePhotosDownloadFailed() {
                googlePopup.close();
            }

            function googlePhotosDownloadSuccess(results) {
                switch (results.Status) {
                    case 'valid':
                    case 'valid pin':
                        const authUrl = 'https://accounts.google.com/o/oauth2/v2/auth?'
                            + 'client_id=' + '771995452976-tj7op7mthkrm52g7hu93u0do967td08h.apps.googleusercontent.com'
                            + '&redirect_uri=' + 'https://public.lightfolio.com/p/google/photosoauth.aspx'
                            + '&response_type=code'
                            + '&scope=https://www.googleapis.com/auth/photoslibrary.appendonly'
                            + '&include_granted_scopes=true'
                            + '&prompt=consent'
                            + '&access_type=offline'
                            + '&state=' + $('[id$="hfCollectionsGuid"]').val();

                        //let popup = window.open(authUrl, "GoogleAuth", "width=600,height=700");
                        googlePopup.location = authUrl;
                        googlePopup.focus();

                        let checkPopup = setInterval(function () {
                            if (!googlePopup || googlePopup.closed) {
                                clearInterval(checkPopup);
                                var l = $('#bDeliverGoogle').ladda();
                                l.ladda('stop');
                                console.log('Authentication popup closed');
                            }
                        }, 1000);
                        break;
                    case 'pin required':
                        $('#AfterPinAction').val(results.FolderImagesId);
                        $('#divModalImage').hide();
                        googlePopup.close();
                        showPinForm();
                        break;
                    case 'login required':
                        $('#divModalImage').hide();
                        googlePopup.close();
                        showPinLoginRequired();
                        break;
                    case 'Insufficient permissions':
                    case 'denied':
                        Ladda.stopAll();
                        googlePopup.close();
                        alert(results.Status || 'Download Failed');
                        break;
                }
            }   

            var googleTokensId;
            var downloadRequestTypesId = 1566;
            function googlePhotoCallback(i) {
                console.log('googlePhotoCallback', i);
                //downloadRequestTypesId = 1567; //google
                googleTokensId = i;
                startDownload(1567); //google
                Ladda.stopAll();

                $('#divDownloadDestination').hide();

                if (singleImagesId == '') {
                    $('#divDownloadProgress').show().html('Processing...');
                    $('#spnEmailNotice').toggle(downloadRequestTypesId == 1566);
                    $('#divDownloadPreparing').show();
                    $('#divDownloadReadyGoogle').hide();
                }
                else {
                    //show google confirmation
                    $('#divDownloadReadyGoogle').show();
                }                
            }

            function googleCheckToken() {
                CallAjax('ContactTokens_FindSession', {}, googleCheckTokenSuccess);
            }

            function googleCheckTokenSuccess(results) {
                
            }
        </script>
        
        

        <div id="divDownloadSpecific" class="lightbox-screen" style="display: none;" bis_skin_checked="1">
            <div class="contents" bis_skin_checked="1">
                <div class="lightbox-frame" bis_skin_checked="1">
                    <div class="lightbox-nav" bis_skin_checked="1">
                        <div id="divSpecificFolders" class="dropdown" style="display: inline-block; padding-right: 15px;" bis_skin_checked="1">
                            <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenu1" data-bs-toggle="dropdown" aria-expanded="true">
                                —
                            </button>
                            <div class="dropdown-menu left" role="menu" aria-labelledby="dropdownMenu1" bis_skin_checked="1"></div>
                        </div>

                        <script id="specific-folders-template" type="text/x-handlebars-template">
                            {{#Items}}
                                <a data-id="{{FoldersId}}" class="dropdown-item" href="#" onclick="{{#compare IsLightbox "==" true}}showSpecificLightboxImages('{{FoldersId}}', this);{{else}}showSpecificFolderImages('{{FoldersGuid}}', this);{{/compare}} return false;">
                                    {{#compare IsLightbox "==" true}}<i class="fal fa-heart fa-fw"></i>{{else}}<i class="fal fa-folder fa-fw"></i>{{/compare}}
                                    {{{FolderName}}} <span style="padding-left: 6px; color: #aaa;">({{NumImages}})</span>                                                 
                                </a>  
                            {{/Items}}
                        </script>

                        <h3 style="display: none;"><span class="specific-selected"></span> of <span class="specific-quantity"></span> <span class="mobile-hide">Images</span> Selected </h3>
                        
                        <a href="https://57906.lightfolio.com/gallery/tazas-endiabladas-con-teco/grODNb0A#" class="cancel" style="position: absolute; top: 10px; right: 20px; font-size: 24px; color: rgb(136, 136, 136); z-index: 902; --darkreader-inline-color: var(--darkreader-text-888888, #9d9488);" onclick="closeDownloadSpecific(); return false;" title="Close" data-darkreader-inline-color="">
                            <i class="fal fa-times"></i>
                        </a>
                    </div>
                    <div class="lightbox-body" bis_skin_checked="1">
                        <ul id="ulSpecificCandidates" class="lightbox-items specific"></ul>
                        <ul id="ulSpecificSelections" class="lightbox-items specific"></ul>

                        <div class="specific-download" style="display: none;" bis_skin_checked="1">
                            <div bis_skin_checked="1">
                                <div class="client-modal-illustration" bis_skin_checked="1">
                                    <i class="fal fa-arrow-down-to-line"></i>
                                </div>

                                <div class="client-modal-instructions" bis_skin_checked="1">
                                    <h5>Start Download</h5>
                                    
                                    <div class="form-group" bis_skin_checked="1">
                                        <input type="text" id="SpecificEmail" name="SpecificEmail" class="form-control email required" placeholder="Email Address">                                                                            
                                    </div>
                                    <div class="buttons" bis_skin_checked="1">
                                        <div bis_skin_checked="1">
                                            <a href="https://57906.lightfolio.com/gallery/tazas-endiabladas-con-teco/grODNb0A#" onclick="closeSpecificDownloader(); return false;" class="cancel">Cancel</a>
                                        </div>                                            
                                        <div bis_skin_checked="1">
                                            <button id="bDownloadSpecific" type="button" onclick="downloadSpecific();" class="submit ladda-button" data-style="expand-right"><span class="ladda-label">Download</span></button>
                                        </div>                                            
                                    </div> 
                                </div>                                
                            </div>                            
                        </div>
                    </div>

                    <script id="specific-items-template" type="text/x-handlebars-template">
                        {{#Items}}
                        <li data-iid="{{ImagesId}}" data-fiid="{{FolderImagesId}}" {{#compare IsSpecificDownloaded "==" true}}class="downloaded"{{/compare}}>

                            <a class="add-selection" onclick="saveSpecificSelection('{{FolderImagesId}}', this);" ><i class="fas fa-plus"></i> Add</a>
                            <a class="remove-selection" onclick="deleteSpecificSelection('{{FolderImagesId}}', this);" ><i class="fas fa-times"></i> Remove</a>                          
                            <div class="selection-downloaded"><i class="fal fa-check fa-fw"></i> Downloaded</div>

                            <div class="overlay"></div>
                            <img src="{{hbLightboxPath this}}" />
                            <div class="filename" title="{{OriginalFileName}}">{{OriginalFileName}}</div>
                        </li>
                        {{/Items}}
                        {{^Items}}
                            <div class="specific-empty"><i class="fal fa-info-circle fa-fw"></i> You have yet to make any selections.  Choose a folder from the dropdown above to begin selecting images.</div>
                        {{/Items}}
                    </script>

                    <div class="lightbox-footer" bis_skin_checked="1">
                        <a id="aDownloadSpecific" href="https://57906.lightfolio.com/gallery/tazas-endiabladas-con-teco/grODNb0A#" onclick="showDownloadGallery(); return false;" class="action success" style="display: none;">Download Image(s)</a>
                        <p id="pDownloadSpecific" style="display: none;"><span class="specific-selected"></span> image(s) selected, <span class="specific-remaining"></span> more image(s) to select</p>
                    </div>
                </div>
            </div>        
            
            <script type="text/javascript">
                var vSpecific;
                function validateDownloadSpecific() {
                    var msgs = {};

                    $('#SpecificEmail').val($('#SpecificEmail').val().replace(/\s/g, '')); //remove any whitespace
                    msgs.SpecificEmail = { required: 'Email is required.', email: 'Please enter a valid email address.' };


                    vSpecific = $('.specific-download').createValidator(msgs);
                    return RunValidation(vSpecific);
                }

                function downloadSpecific() {
                    if (validateDownloadSpecific()) {
                        downloadStarted = true;

                        var l = $('#bDownloadSpecific').ladda();
                        l.ladda('start');

                        CallAjax('DownloadRequests_StartSpecific', { collectionsGuid: $('[id$="hfCollectionsGuid"]').val(), emailAddress: $('#SpecificEmail').val(), tokensId: '' }, downloadSpecificSuccess);
                    }
                }

                function downloadSpecificSuccess(results) {
                    Ladda.stopAll();

                    if (results.TokenFailed) {
                        googleTokensId = ''; //reset
                        toastr.error('Request failed');
                        return;
                    }
                    else if (results.Error) {                        
                        toastr.error(results.Message || 'Request failed');
                        return;
                    }

                    closeDownloadSpecific();

                    if (results.Status == 'pin required' || results.Status == 'pin gallery') {
                        $('#AfterPinAction').val('SpecificDownload');                        
                        showPinForm();
                    }
                    else {
                        //$('#AfterPinAction').val(''); //clear
                        //$('#divDownloadStart').hide().clearForm();
                        
                        downloadStarted = false;
                        $('#spnEmailNotice').toggle(downloadRequestTypesId == 1566);
                        $('#divDownloadPreparing').show();
                        startDownloadProgress(results);
                        toastr.success('Your image(s) will be delivered by email')
                    }
                }

                var specificSelections = [];

                function bindSpecificSelections(init, fiid) {
                    if($('[id$="hfDownloadSpecific"]').val() == 'true')
                        CallAjax('FolderImages_GetSpecific', { collectionsGuid: $('[id$="hfCollectionsGuid"]').val() }, function (results) { bindSpecificSelectionsSuccess(results, init, fiid); });
                }
                
                function bindSpecificSelectionsSuccess(results, init, fiid) {
                    if (results.Error) {
                        closeDownloadSpecific();
                        toastr.error(results.Message || 'Request failed');
                        return;
                    }
                        
                    var source = $("#specific-items-template").html();
                    var template = Handlebars.compile(source);
                    var data = { 'Items': results };
                    $("#ulSpecificSelections").html(template(data));

                    specificSelections = results;
                    if (init)
                        showSpecificSelections();
                    else
                        highlightSpecificSelected();

                    var quantity = GetInteger($('[id$="hfSpecificQuantity"]').val());
                    var remaining = quantity - GetInteger(results.length);
                    $('.specific-quantity').html(quantity);                    
                    $('.specific-selected').html(results.length);
                    $('.specific-selected-menu').html('(' + results.length + ')');
                    $('.specific-remaining').html(remaining == 0 ? 'no' : remaining); 

                    $('#aDownloadSpecific').toggle(results.length == quantity);
                    $('#pDownloadSpecific').toggle(results.length < quantity);

                    if (fiid)
                        toggleModalSpecificCount(fiid);
                }

                function highlightSpecificSelected() {
                    console.log('highlightSpecificSelected', specificSelections.length);

                    $('#ulSpecificCandidates li, #ulSpecificSelections li').removeClass('selected');
                    $(".grid-item .stats-download,.video-item .stats-download").removeClass('value');
                    for (var x = 0; x < specificSelections.length; x++) {
                        var cls = 'selected';
                        if (specificSelections[x].IsSpecificDownloaded)
                            cls += ' downloaded';

                        $('#ulSpecificCandidates li[data-iid="' + specificSelections[x].ImagesId + '"]').addClass(cls);
                        $('#ulSpecificSelections li[data-fiid= "' + specificSelections[x].FolderImagesId + '"]').addClass(cls);
                        //$('.grid-item[data-iid="' + specificSelections[x].ImagesId + '"] .stats-download').addClass('value');
                        //$('.video-item[data-vid="' + specificSelections[x].VideosId + '"] .stats-download').addClass('value');
                    }
                }

                function saveSpecificSelection(fiid, li) {
                        CallAjax('FolderImages_SaveSpecific', { collectionsGuid: $('[id$="hfCollectionsGuid"]').val(), folderImagesId: fiid }, function (results) { saveSpecificSelectionSuccess(results, fiid); });
                }

                function toggleModalSpecificCount(fiid) {
                    var idx = arrayIndexOf(activeData, 'FolderImagesId', fiid);
                    var iid = activeData[idx].ImagesId;
                    var selected = $('#ulSpecificSelections li[data-iid="' + iid + '"]').length > 0;
                    console.log('selected for ' + iid, selected);
                    $('.ps-button .fa-arrow-down-to-line').toggleClass('value', selected);
                }

                function saveSpecificSelectionSuccess(results, fiid) {
                    if (results.Error)
                        toastr.error(results.Message || 'Request failed');
                    else 
                        bindSpecificSelections(null, fiid);
                }

                function deleteSpecificSelection(fiid) {
                    CallAjax('FolderImages_DeleteSpecific', { collectionsGuid: $('[id$="hfCollectionsGuid"]').val(), folderImagesId: fiid }, function (results) { deleteSpecificSelectionSuccess(results, fiid); });
                }

                function deleteSpecificSelectionSuccess(results, fiid) {
                    if (results.Error)
                        toastr.error(results.Message || 'Request failed');
                    else
                        bindSpecificSelections(null, fiid);
                }
            </script>

            <script type="text/javascript">
                //function showSpecificDownloader() {
                //    $('.specific-download').show();
                //}

                //function closeSpecificDownloader() {
                //    $('.specific-download').hide();
                //}

                function showDownloadSpecific() {
                    $(".specific-download input").keydown(function (e) {
                        if (e.keyCode == 13 && downloadStarted == false) {
                            downloadStarted = true;
                            downloadSpecific();
                        }
                    });

                    Ladda.stopAll();

                    if (vSpecific)
                        vSpecific.resetForm();

                    stopScrolling();
                    //closeSpecificDownloader();
                    $('[id$="pnlDownloads"]').hide();
                    bindSpecificSelections(true);

                    var source = $("#specific-folders-template").html();
                    var template = Handlebars.compile(source);
                    var data = { 'Items': allFolders };
                    $("#divSpecificFolders .dropdown-menu").html(template(data));

                    source = $("#specific-folders-template").html();
                    template = Handlebars.compile(source);
                    data = { 'Items': (typeof lightboxes !== 'undefined' ? [] : lightboxes) };
                    $("#divSpecificFolders .dropdown-menu").append(template(data));

                    $("#divSpecificFolders .dropdown-menu").append('<div class="dropdown-divider"></div>');
                    $("#divSpecificFolders .dropdown-menu").append('<a class="dropdown-item" href="#" onclick="showSpecificSelections(this); return false;"><i class="fal fa-check-circle fa-fw"></i> My Selections <span class="specific-selected-menu"></span></a>');

                    $('#divSpecificFolders .btn').html('<i class="fal fa-check-circle fa-fw"></i> My Selections <span class="specific-selected-menu"></span>');


                    //$('#ulSpecificLightboxes').toggle(lightboxes.length > 0);

                    //if (typeof lightboxes !== 'undefined') {
                    //    for (var x = 0; x < lightboxes.length; x++) {
                    //        if (lightboxes[x].NumImages > 0 && $('[id$="hfAllowFavoritesDownload"]').val() == 'true') {
                    //            var id = lightboxes[x].FoldersGuid;
                    //            $('#ulSpecificFolders').append('<li><input type="checkbox" id="dg-' + id + '" value="' + id + '" onclick="toggleFoldersSelected();" /><label for="dg-' + id + '"><i class="fas fa-heart"></i> ' + lightboxes[x].FolderName + '</label></li>');
                    //            //numDownloadableFolders++;
                    //        }
                    //    }
                    //}

                    $('#divDownloadSpecific').show();
                }

                function showSpecificSelections(a) {
                    if(a)
                        $('#divSpecificFolders .btn').html($(a).html());

                    highlightSpecificSelected();
                    $('#ulSpecificCandidates').hide();
                    $('#ulSpecificSelections').show();
                }

                function showSpecificFolderImages(i, a) {
                    $('#divSpecificFolders .btn').html($(a).html());

                    CallAjax('FolderImages_GetByFolder', { foldersGuid: i }, showSpecificFolderImagesSuccess);                    
                }

                function showSpecificFolderImagesSuccess(results) {
                    var source = $("#specific-items-template").html();
                    var template = Handlebars.compile(source);
                    var data = { 'Items': results };
                    $("#ulSpecificCandidates").html(template(data));

                    highlightSpecificSelected();
                    $('#ulSpecificCandidates').show();
                    $('#ulSpecificSelections').hide();
                }

                function showSpecificLightboxImages(i, a) {
                    $('#divSpecificFolders .btn').html($(a).html());

                    var filtered = lightboxes.filter(
                        function (lb) {
                            return lb.FoldersId == i;
                        }
                    )[0];

                    var source = $("#specific-items-template").html();
                    var template = Handlebars.compile(source);
                    var data = { 'Items': filtered.Items };
                    $("#ulSpecificCandidates").html(template(data));

                    highlightSpecificSelected();
                    $('#ulSpecificCandidates').show();
                    $('#ulSpecificSelections').hide();
                }

                function closeDownloadSpecific() {
                    $('#divDownloadSpecific').hide();
                    startScrolling();
                }
            </script>
        </div>


