    <style type="text/css">
        body.noscroll { overflow-y: hidden; }
        .header-galleries { flex-shrink: 1;  }
        label.error {font-size: 11px; letter-spacing: 1px; color: #EF4836; margin-top: 4px; display: block; text-align: left;}
        .vertical .tippy-popper {display: none !important;}
        .vertical .lightbox-nav .tippy-popper {display: inherit !important;}

        .page-load-status p { padding: 20px; text-align: center; font-weight: bold; }

        .specific-selected-menu { color: #aaa; padding-left: 6px; }

/*        .grid-item .wrapper img { z-index: 1; }
        .grid-item .overlay { background-image: url('/assets/images/blank.gif'); background-size: cover; background-repeat: repeat; opacity: 1; }*/

        

        .video-download { padding-top: 10px; text-align: right; flex-basis: 100%; }
        .video-download a { color: rgba(0,0,0,.5); }
        .dark .video-download a { color: rgba(255,255,255,.5); }
        .video, .video-wrapper { height: 100vh; }
        .video-wrapper > iframe { width: 100%; height: 100%; }
        .video-overlay { position: absolute; top: 0; left: 0; bottom: 0; right: 0; z-index: 10; background: rgba(0,0,0,.3);}
        .video-html { position: absolute; top: 0; left: 0; bottom: 0; right: 0; z-index: 11; }

        .video { position: relative; overflow: hidden; }

        .video-wrapper {
           top: 0;
           left: 0;
           width: 100%;
           height: 100%;
           z-index: -1;
           pointer-events: none;
           overflow: hidden;
        }
        .video-wrapper iframe {
           width: 100vw;
           min-height: 100vh;
           position: absolute;
           top: 50%;
           left: 50%;
           transform: translate(-50%, -50%);
        }
        .video-wrapper.ar16by9 iframe{
            height: 56.25vw;/**/ /* Given a 16:9 aspect ratio, 9/16*100 = 56.25 */
            min-width: 177.77vh; /**/ /* Given a 16:9 aspect ratio, 16/9*100 = 177.77 */
        }
        .video-wrapper.ar16by10 iframe{ height: 62.5vw; min-width: 160.0vh; }


        .pswp__scroll-wrap {  }
        .pswp__img { pointer-events: none; }
        .pswp__video-container { position: relative; }
        .pswp__video-container iframe { width: 100%; height: 100%; }
        .pswp__bg { background-color: #fff !important; opacity: 1 !important; }
        .pswp__counter { color: #222; margin-right: 15px; background-color: rgba(245,245,245,.8); border-radius: 6px; padding: 0 8px; text-shadow: none; }
        .pswp__button--close.lc { display: none; }
        .ps-button { white-space: nowrap; width: auto; padding: 0 5px; color: #222; font-size: 14px; }
        .ps-button:hover { padding: 0 5px; }
        .ps-button i { width: 35px; height: 35px; background: rgba(245,245,245, .8); border-radius: 50%; margin: 0 auto; /*display: flex; align-items: center; justify-content: center;*/ transition: all 0.3s; }
        .ps-button i::before { display: flex; align-items: center; justify-content: center; font-size: 18px; height: 100%; }
        .ps-button i:hover { background: #e5e5e5; }

        @media screen and (max-width: 900px) {
            .pswp__top-bar { padding-right: 5px; }
            .pswp__preloader { /*display: none;*/ }
            .pswp__button--close { display: none; }
            .pswp__button--close.lc { display: block; }
            .pswp__counter { display: none; }
            .ps-button { /*width: 35px;*/ height: 50px;  font-size: 14px; margin: 0 /*2px*/; }
            .ps-button i { width: 33px; height: 33px; background: none; }
            .ps-button i:hover { background: none; }
            .pswp__counter { margin-top: 12px; margin-left: 10px; font-size: 12px;  }
            .pswp__button--zoom { margin-left: 5px; }
            .pswp__button--zoom { display: none !important; }
        }

        #ulSpecificCandidates .remove-selection { display: none !important; /*don't allow for now*/}
    </style><style class="darkreader darkreader--sync" media="screen"></style>    

    
