<script type="text/javascript">
    window.onresize = function () {

    };

    //var masonryGrid;
    var gutterWidth = 0;

    $(document).ready(function () {
        gutterWidth = parseInt($('[id$="hfBrickMargin"]').val()) || 0;

        if (gutterWidth >= 30) {
            $('.holder').addClass('wide');
        }

        //var pack = $('.grid').masonry({
        //    itemSelector: '.grid-item',
        //    //use grid-style-tight only for left side nav?
        //    percentPosition: true, //remove for grid-style-tight, must use pixel width, not %
        //    columnWidth: '.grid-sizer', //remove for grid-style-tight, must use pixel width, not %
        //    horizontalOrder: $('[id$="hfUseHorizontalOrder"]').val() == 'true',
        //}).on('layoutComplete', function () {
        //    setGalleryBody();
        //});

        var pack = $('.grid').packery({
            itemSelector: '.grid-item',
            percentPosition: true, //remove for grid-style-tight, must use pixel width, not %
            columnWidth: '.grid-sizer', //remove for grid-style-tight, must use pixel width, not %

        }).on('layoutComplete', function () {
            setGalleryBody();
        });



        if (typeof initInfiniteScroll === 'function')
            initInfiniteScroll(pack);






        $('.grid').packery('layout'); //fix any gaps

        if ($('.cover-fade').length)
            $('body').css('position', 'fixed');
    });

    function showGallery() {
        $('body').css('position', 'unset');

        if ($('.cover-fade').length) {
            $('.cover-fade').fadeOut(700); //css('opacity', '0').hide(); //.css('position', 'unset');
            if (typeof triggerResize === 'function')
                triggerResize();
        }

        var scroll = new SmoothScroll();
        var anchor = $('#divHeader:visible,#divHeaderMobile:visible');
        var toggle = document.querySelector('.cover-button');
        var options = { speed: 700, easing: 'easeOutCubic' };
        scroll.animateScroll(anchor[0], toggle, options);

        //$('body').css('position', 'unset');

        //if ($('.cover-fade').length)
        //    $('.cover-fade').css('opacity', '0').hide();

        //$('html, body').animate({
        //    scrollTop: $("#divHeader").offset().top
        //}, 0);
    }
</script>

