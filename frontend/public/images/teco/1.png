<style type="text/css">
    #divAssociatedLists .item {max-width: 100%;  padding: 0 0;}
    #divAssociatedLists .image {position: relative;}
    #divAssociatedLists .image-overlay {position: absolute; top: 0; left: 0; bottom: 0; right: 0; z-index: 999;}
    #divAssociatedLists .image img { max-width: 100%; max-height: 300px; }
    #divAssociatedLists .select-list { list-style: none; text-align: left; font-size: 14px; margin: 20px 0;}
    #divAssociatedLists .select-list li { margin-bottom: 10px; }
    #divAssociatedLists .select-list li.value i {color: #D64541;}
    #divAssociatedLists .select-list li a {text-decoration: none; }

    #aFavoriteFile { color: #aaa; transition: all 0.3s; }
    #aFavoriteFile:hover { color: #333; }
    
    .submit-lightbox-status { padding: 10px; color: #26A65B; }
    
    li.source-folder { display: flex !important; }
    li.source-folder > div:first-child { flex-grow: 1; }
    li.source-folder > div:last-child { font-weight: normal; color: #3fc380; }

    .lightbox-tippy-list {text-align: left; padding: 8px 0; font-size: 14px;}
    .lightbox-tippy-list > li {display: flex; position: relative; padding: 0 6px;}
    .lightbox-tippy-list > li > div { padding: 0;}
    .lightbox-tippy-list > li a { padding: 8px 14px; display: inline-block; color: #555; text-decoration: none; transition: all 0.3s;}
    .lightbox-tippy-list.ctrl > li > a { }
    .lightbox-tippy-list > li.disabled a {color: #ccc !important; cursor: default;}
    .lightbox-tippy-list > li.active a {  }
    .lightbox-tippy-list .dropdown-header { padding: 8px 20px; color: #aaa; text-transform: uppercase; font-size: 11px; letter-spacing: .5px;}
    
    .lightbox-tippy-list > li:hover > a { color: #111;}
    .lightbox-tippy-list > li.divider { height: 1px; margin: 9px 0; overflow: hidden; background-color: rgba(0,0,0,.1);}
    .lightbox-tippy-list > li i {font-size: 12px; }
    .lightbox-tippy-list > li > a > i { padding-right: 4px;}

    .lightbox-tippy-list .lb { flex: 1 0 auto; }
    .lightbox-tippy-list .lb a { display: block;  color: #333; font-size: 16px;}

    .lightbox-tippy-list .set-active { flex: 0 0 auto; }
    .lightbox-tippy-list .set-active a { padding: 5px 3px; }

    .lightbox-tippy-list .ctrl { flex: 0 0 auto; text-align: right; padding-top: 5px; padding-right: 14px;}
    .lightbox-tippy-list .ctrl a { display: inline-block; padding: 5px 3px; color: #ccc; transition: all 0.3s;}
    .lightbox-tippy-list .ctrl a:hover { color: #333;}

    .light-theme .tippy-content { padding: 0;}

    .lightbox-tippy-list.lightbox-menu li.active i::before { content: "\f005"; font-weight: bold;}

    
</style><style class="darkreader darkreader--sync" media="screen"></style>

