                <script type="text/javascript">
                    //function toggleMobileSettings() {
                    //    $('.lightbox-mobile-settings').toggleClass('lightbox-display');
                    //    $('.lightbox-body').toggle(!$('.lightbox-mobile-settings').is(':visible'));
                    //    $('.lightbox-frame').toggle();
                    //}

                    function showMobileBody() {
                        $('.lightbox-body').removeClass('lightbox-mobile-hide');
                        $('.lightbox-nav').removeClass('lightbox-mobile-hide');
                        $('.lightbox-mobile-settings').removeClass('lightbox-mobile-show');
                        $('.lightbox-mobile-details').removeClass('lightbox-mobile-show');
                    }

                    function showMobileSettings() {
                        $('.lightbox-body').addClass('lightbox-mobile-hide');
                        $('.lightbox-nav').addClass('lightbox-mobile-hide');
                        $('.lightbox-mobile-settings').addClass('lightbox-mobile-show');
                        $('.lightbox-mobile-details').removeClass('lightbox-mobile-show');
                    }

                    function showMobileDetails() {
                        $('.lightbox-body').addClass('lightbox-mobile-hide');
                        $('.lightbox-nav').addClass('lightbox-mobile-hide');
                        $('.lightbox-mobile-settings').removeClass('lightbox-mobile-show');
                        $('.lightbox-mobile-details').addClass('lightbox-mobile-show');
                    }

                    function submitLightbox() {
                        if(confirm('Are you sure?'))
                            CallAjax('Folders_SubmitLightbox', { foldersId: activeLightbox, collectionsGuid: $('[id$="hfCollectionsGuid"]').val() }, submitLightboxSuccess);
                    }

                    function submitLightboxSuccess(results) {
                        if (results.Success) {
                            if(results.IsLightboxSubmitted)
                                toastr.success('Favorites submitted!');
                            else
                                toastr.success('You have revoked your submission');
                            //$('.submit-lightbox').html(results.IsLightboxSubmitted ? '<i class="fas fa-circle-check fa-fw"></i> Submitted' : 'Submit Favorites');

                            displayLightboxSubmitted(results);
                        }
                        else
                            toastr.error('Submission failed');
                    }

                    function revokeLightbox() {
                        if (confirm('Are you sure?'))
                            CallAjax('Folders_SubmitLightbox', { foldersId: activeLightbox, collectionsGuid: $('[id$="hfCollectionsGuid"]').val() }, submitLightboxSuccess);
                    }

                    function displayLightboxSubmitted(obj) {
                        //console.log('display', obj);
                        if (obj.IsLightboxSubmitted) {
                            $('.submit-lightbox').hide();
                            $('.submit-lightbox-status').html("Submitted: " + obj.LightboxSubmitted);
                            $('.revoke-lightbox').show();                            
                        }
                        else {
                            $('.submit-lightbox').show();
                            $('.revoke-lightbox').hide();
                        }

                        var idx = arrayIndexOf(lightboxes, 'FoldersId', obj.FoldersId);
                        lightboxes[idx].IsLightboxSubmitted = obj.IsLightboxSubmitted;
                        lightboxes[idx].LightboxSubmitted = obj.LightboxSubmitted;
                    }
                </script>

