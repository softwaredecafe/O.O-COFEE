    <div id="divImageDetails" class="image-details" bis_skin_checked="1">
            
        <div class="details-close" bis_skin_checked="1">
            <a href="https://57906.lightfolio.com/gallery/tazas-endiabladas-con-teco/grODNb0A#" onclick="hideDetails(); return false;"><i class="fal fa-times"></i></a>
        </div>

        <div class="details-top" bis_skin_checked="1">                        
            <div class="details-collection" bis_skin_checked="1"><b>Tazas endiabladas con Teco</b></div>
            <div class="details-counter" bis_skin_checked="1">46 <span>of</span> 55</div>
            <div class="details-filename" bis_skin_checked="1" style="display: none;">Tazas endiabladas con Teco - Siena Luz 7 de diciembre (46).jpg</div>
            <div class="details-title" bis_skin_checked="1"></div>    
        </div>   

        <div class="details-bottom" bis_skin_checked="1">    
            <div class="details-description" style="display: none;" bis_skin_checked="1">
                <div class="title" bis_skin_checked="1">Description</div>
                
            </div>    
            
            <div class="details-keywords" style="display: none;" bis_skin_checked="1">
                <div class="title" bis_skin_checked="1">Keywords</div>
                <div class="value" bis_skin_checked="1"></div>
            </div> 

            <div class="details-comments" bis_skin_checked="1"></div> 
        </div>              

        <script id="comments-template" type="text/x-handlebars-template">
            <li class="add">
                <div class="body">
                    <div class="comment">
                        <div class="left">
                            <i class="fal fa-comment"></i>
                        </div>
                        <div class="right"><textarea id="Comments" placeholder="Add a Comment" onkeyup="toggleActiveAdd();"></textarea></div>
                    </div>
                    <div class="controls">
                        <div class="left"><input id="CommentsAuthor" type="text" placeholder="Enter your name" maxlength="100" /></div>
                        <div class="right"><a href="#" onclick="cancelComment(); return false;" class="cancel">Cancel</a> <a id="aAddComment" href="#" onclick="addComment(); return false;" class="ladda-button" data-style="expand-right"><span class="ladda-label">Save</span></a></div>
                    </div>
                </div> 
            </li>
            {{#items}}
            <li>
                <div class="identity-mug">
                    {{#compare IdentityFileName "!=" null}}
                        <div class="image" style="background-image: url('{{hbDocumentCdnPath IdentityFileName}}');"></div>
                    {{else}}
                        <div><span>{{#compare Initials "==" null}}<i class="fal fa-star"></i>{{else}}{{Initials}}{{/compare}}</span></div>
                    {{/compare}}  
                </div>
                <div class="body">
                    <div class="details">
                        <div>{{#compare Identity "==" null}}{{#compare Author "==" null}}Anonymous{{else}}{{Author}}{{/compare}}{{else}}
                                {{Identity}}
                            {{/compare}}
                        </div><div>{{CreatedAgo}}</div>
                    </div> 
                    <div class="comments">{{Comments}}</div>
                </div>                                                    
            </li>
            {{/items}}
            {{^items}}
            <li style="font-style: italic;">No Comments yet.</li>
            {{/items}}
        </script>
    </div>

    <style type="text/css">
        .image-details { display: none; border-right: 1px solid #ddd; background-color: #fff;
                         z-index: 999999; overflow-y: auto; position: fixed; top: 0; left: 0; bottom: 0; width: 100%; max-width: 350px; }
        .image-details.display { display: block; }

        .image-details.display:after {
            content:"";
            position:absolute;
            width:100%;
            bottom:1px;
            z-index:-1;
            transform:scale(.9);
            box-shadow: 10px 0 5px -2px #888;
        }

        .details-top { 
            padding: 20px;
          color: #555;
          font-size: 14px;
        }
        .details-bottom { 
            padding: 20px;
          overflow-y: auto;
          color: #333;
        }

        .details-close { position: absolute; top: 10px; right: 20px; }
        .details-close a { font-size: 24px; color: #aaa; transition: all 0.3s; }
        .details-close a:hover { color: #555; }

        .details-counter{color: #aaa; margin-bottom: 20px; font-size: 24px; font-weight: 300;}
        @media screen and (max-width: 900px) {
            .details-counter { font-size: 14px; color: #888; }
        }
        .details-collection {font-size: 14px; color: #555;}
        .details-title{font-size: 20px; font-weight: bold; color: #555;}
        .details-description{ }

        .details-date {border-top: 1px solid #ccc; display: inline-block; padding-top: 6px; margin-top: 6px; margin-bottom: 20px;}
        .dark .details-date { border-color: #555;}
        .details-date:empty {display: none;}
        .details-date i {padding-right: 6px;}

        .details .title {font-weight: bold; font-style: normal; color: #333; margin-bottom: 5px;}
        .dark .details .title { color: #555; }
        .details-filename{color: #aaa; font-style: italic; font-size: 14px; /*overflow: hidden; text-overflow: ellipsis; white-space: nowrap;*/  word-break: break-all; }
        .details-keywords{margin: 20px 0;}

        .details-keywords a {display: inline-block; padding: 2px 8px; border: 1px solid #aaa; color: #777; border-radius: 5px; margin-right: 8px; margin-bottom: 8px; text-decoration: none !important;}
        .details-keywords a:hover { color: #3498db; border-color: #3498db; }
        .details-galleries {margin: 0 0 20px 0;}
        .details-galleries a {display: inline-block; padding-right: 8px; text-decoration: underline;}

        .details-overflow {flex: 1 1 auto; padding: 20px; overflow-y: auto; color: #333; }
        .dark .details-overflow { color: #555; }


        .details-comments { }
        /*.details-comments > ul { overflow-y: scroll; flex-grow: 1;}    */
        .details-comments ul { padding-top: 10px;}
        .details-comments li { display: flex; color: #333; padding-bottom: 20px; font-size: 16px;}
        .dark .details-comments li { color: #555; }
        .details-comments .identity-mug { flex: 0 0 40px;}
        .details-comments .body { flex: 1 1 auto; font-size: 12px;}
        .details-comments .add .identity-mug { padding-top: 8px;}
        .details-comments .add .comment { display: flex; border: 1px solid #555; border-radius: 4px; padding: 10px;}
        .details-comments .comment .left {flex: 0 0 28px; }
        .details-comments .comment .left i { padding-top: 3px;}
        .details-comments .comment .right {flex: 1 1 auto;}
        .details-comments .comment .right textarea { display: block; width: 100%; height: 20px; resize: none; border: none; font-size: 16px; box-sizing: border-box; background-color: transparent;}
        .dark .details-comments .comment .right textarea { color: #aaa;}

        .details-comments .controls { display: none; padding-top: 10px;}
        .details-comments .add.active .controls {display: block;}
        .details-comments .controls .right { }
        .details-comments .controls .right a { display: inline-block; color: #fff; background: #333; padding: 3px 12px; border-radius: 12px; font-size: 14px;}
        .details-comments .controls .right a.cancel { color: #555; background: #e5e5e5;}
        .details-comments .controls .left { flex: 1 1 auto; margin-bottom: 10px;}
        .details-comments .controls .left input { width: 100%; box-sizing: border-box;; padding: 10px; border: 1px solid #555; border-radius: 4px;}

        .details-comments .details {display: flex; font-size: 14px;}
        .details-comments .details > div {flex: 1 0 auto;}
        .details-comments .details > div:first-of-type { font-weight: bold; color: #333;}
        .details-comments .details > div:last-of-type {text-align: right; font-size: 12px; color: #aaa; }
        .details-comments .comments { color: #888;}

        .modal-video { position: fixed; z-index: 9999; top: 0; left: 0; bottom: 0; right: 0; background-color: #fff; }
        .modal-video-wrapper { background: #fff; border-radius: 8px; padding: 50px; width: 100%; height: 100%; box-shadow: 0 0 10px rgba(0,0,0,.1); }
        .modal-video iframe { width: 100%; height: 100%; display: block; margin: 0 auto; background: #111; box-shadow: 0 0 10px rgba(0,0,0,.1); border-radius: 6px; }
        .modal-video-close { position: absolute; top: 0; right: 0; font-size: 24px; color: #aaa; transition: all 0.3s; }
        .modal-video-close:hover { color: #333; }

        @media screen and (max-width: 900px) {
            .modal-video-wrapper { padding: 20px; }
            .modal-video-close { font-size: 18px; }
        }
    </style><style class="darkreader darkreader--sync" media="screen"></style>
    <script type="text/javascript">
        var lastFrom;

        function showComments(fiid) {
            console.log('showComments for ' + fiid);
            toggleAutoplay(true); //force stoppage
            showDetails(fiid, true);
            lastFrom = 'comments';
        }

        function showImageDetails(fiid) {
            console.log('showImageDetails for ' + fiid);

            toggleAutoplay(true); //force stoppage
            //toggleComments(true);
            showDetails(fiid, false);
            lastFrom = 'details';
        }

        function hideDetails() {
            $('#divImageDetails').removeClass('display');
        }

        function showDetails(fiid, fromComments) {
            console.log('fromComments', fromComments);
            console.log('lastFrom', lastFrom);
            if (fromComments == true && lastFrom == 'details') {
                $('#divImageDetails').toggleClass('display', true);
            }
            else if (fromComments == false && lastFrom == 'comments') {
                $('#divImageDetails').toggleClass('display', true);
            }
            else {
                console.log('toggling display...', $('#divImageDetails').hasClass('display'));
                $('#divImageDetails').toggleClass('display');
                console.log('now:', $('#divImageDetails').hasClass('display'));
            }
        }
    </script>
