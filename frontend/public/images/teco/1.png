        <script type="text/javascript">
            var slickInitialzed = false;
            var selectedIndex;
            var wasHorizontal;
            var photoSwiper, psSlideshow;
            var thisIid, thisVid, thisFiid, thisGridItem;

            function psOptions() {
                if ($('[id$="hfShowFileNames"]').val() == 'true') {
                    photoSwiper.pswp.ui.registerElement({
                        name: 'custom-caption',
                        order: 9,
                        isButton: false,
                        appendTo: 'root',
                        html: 'Caption text',
                        onInit: (el, pswp) => {
                            photoSwiper.pswp.on('change', () => {
                                const currSlideElement = photoSwiper.pswp.currSlide.content.element;
                                //console.log('currSlideElement', currSlideElement);
                                let captionHTML = currSlideElement.getAttribute('alt'); // '';
                                el.innerHTML = '<span>' + captionHTML || '' + '</span>';
                            });
                        }
                    });
                }

                photoSwiper.pswp.ui.registerElement({
                    name: 'info-button',
                    className: 'ps-button ps-button-info',
                    ariaLabel: 'Info',
                    order: 7,
                    isButton: true,
                    html: '<i class="fal fa-info"></i>',
                    onClick: (event, el) => {
                        console.log('image infor...', thisFiid);
                        showImageDetails(thisFiid);
                    }
                });

                

                      
                
                    photoSwiper.pswp.ui.registerElement({
                        name: 'download-button',
                        className: 'ps-button ps-button-download',
                        ariaLabel: 'Download',
                        order: 8,
                        isButton: true,
                        html: '<i class="fal fa-arrow-down-to-line"></i>',
                        onClick: (event, el) => {
                            console.log('download image...', thisFiid);
                            var vi = $('.video-item[data-fiid="' + thisFiid + '"]');
                            if (vi.length > 0)
                                downloadVideo(vi.find('.stats-download a'));
                            else 
                                downloadImage(thisFiid);
                        }
                    });
                                    
                
                
                
                
                
            }

            function cancelComment() {
                $('#Comments').val(''); //reset
                autosize.update($('#Comments'));
                $('#ulComments .add.active').removeClass('active');
            }

            function addComment(){
                if ($('#Comments').val().trim() != '') {
                    var l = $('#aAddComment').ladda();
                    l.ladda('start');

                    var fiid = thisFiid; // $('.slick-current').attr('data-fiid');
                    CallAjax('FolderImageActivities_SaveComments', {collectionsGuid: $('[id$="hfCollectionsGuid"]').val(), folderImagesId: fiid, comments: $('#Comments').val(), description: $('#CommentsAuthor').val()}, addCommentSuccess);
                }                
            }

            function addCommentSuccess(results) {
                Ladda.stopAll();
                bindComments(results[0].NumComments);

                $('#Comments').val(''); //reset
                $('#CommentsAuthor').val(''); //reset

                var obj = results[0];
                var div = $('.grid-item[data-fiid="' + obj.FolderImagesId + '"]');
                if (div.length == 0)
                    div = $('.carousel-cell[data-fiid="' + obj.FolderImagesId + '"]');

                $('#aModalComments .value').remove();
                if (obj.NumComments > 0) {
                    $('#aModalComments').append('<div class="value">' + obj.NumComments + '</div>');
                    div.find('.details-selected .details-comment span').html(obj.NumComments);
                    //$('#spnLikeCount').html(obj.NumLikes).show();
                    div.find('.details-selected .details-comment').addClass('value');
                }                    
                else{
                    //$('#spnLikeCount').html('').hide();                    
                    div.find('.details-selected .details-comment span').html('');
                    div.find('.details-selected .details-comment').removeClass('value');
                }
                  
                div.find('.stats-comment').toggleClass('value', obj.NumComments > 0);
                $('.ps-button .fa-comments').toggleClass('value', obj.NumComments > 0);
            }

            function bindComments(numComments) {                
                if (numComments > 0) {
                    var fiid = thisFiid; // $('.slick-current').attr('data-fiid');
                    CallAjax('FolderImageActivities_GetComments', { collectionsGuid: $('[id$="hfCollectionsGuid"]').val(), folderImagesId: fiid }, bindCommentsSuccess);
                }
                else
                    bindCommentsSuccess([]);
            }

            function bindCommentsSuccess(results){
                var source = $("#comments-template").html();
                var template = Handlebars.compile(source);
                var data = { 'items': results };
                $("#ulComments").html(template(data));

                $(".details-comments").animate({ scrollTop: 0 }, "fast");
                autosize($('#Comments')); 
            }

            function toggleModalActions(){
                if($('.modal-mobile-actions').length)
                    $('.modal-mobile-actions').removeClass('modal-mobile-actions');
                else
                    $('#divModalImage').addClass('modal-mobile-actions');
            }

            function toggleActiveAdd() {
                $('#Comments').closest('.add').addClass('active');
            }

            function descriptionHtml(input) {
                input = input || ''
                let text = input;
                //return text;

                const linksFound = text.match(/(?:www|https?)[^\s]+/g);
                const aLink = [];

                if (linksFound != null) {
                    for (let i = 0; i < linksFound.length; i++) {
                        let replace = linksFound[i];
                        if (!(linksFound[i].match(/(http(s?)):\/\//))) { replace = 'http://' + linksFound[i] }
                        let linkText = replace;
                        //let linkText = replace.split('/')[2];
                        //if (linkText.substring(0, 3) == 'www') { linkText = linkText.replace('www.', '') }
                        //if (linkText.match(/youtu/)) {

                        //    let youtubeID = replace.split('/').slice(-1)[0];
                        //    aLink.push('<div class="video-wrapper"><iframe src="https://www.youtube.com/embed/' + youtubeID + '" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>')
                        //}
                        //else if (linkText.match(/vimeo/)) {
                        //    let vimeoID = replace.split('/').slice(-1)[0];
                        //    aLink.push('<div class="video-wrapper"><iframe src="https://player.vimeo.com/video/' + vimeoID + '" frameborder="0" webkitallowfullscreen mozallowfullscreen allowfullscreen></iframe></div>')
                        //}
                        //else {
                        //    aLink.push('<a href="' + replace + '" target="_blank">' + linkText + '</a>');
                        //}
                        aLink.push('<a href="' + replace + '" target="_blank">' + linkText + '</a>');

                        text = text.split(linksFound[i]).map(item => { return aLink[i].includes('iframe') ? item.trim() : item }).join(aLink[i]);
                    }
                    return text.replace(/(?:\r\n|\r|\n)/g, '<br>');
                }
                else {
                    return input.replace(/(?:\r\n|\r|\n)/g, '<br>');
                }
            }

            function updateVideoSize() {

                var winheight = $('body').height();
                $('.video-layout-large .video-item').each(function (i, v) {
                    var w = GetInteger($(v).attr('data-width'));
                    var h = GetInteger($(v).attr('data-height'));

                    var targetHeight = winheight * .9;
                    var maxWidth = $('.videos').width();

                    if (h > w) {
                        var targetWidth = targetHeight * (w / h);
                        //console.log('targetWidth', targetWidth);
                        if (targetWidth < 200)
                            targetWidth = 250;
                        if (targetWidth > maxWidth)
                            targetWidth = maxWidth;
                        $(v).css('width', targetWidth + 'px');
                    }
                });
            }

            function loadVideo(c) {
                modalVideo();

                var item = $(c).closest('.video-item');

                var w = GetInteger(item.attr('data-width'));
                var h = GetInteger(item.attr('data-height'));

                var winheight = $('.modal-video-wrapper').height();
                var targetHeight = winheight; // * .9;
                var maxWidth = $('.modal-video-wrapper').width();

                var targetWidth = targetHeight * (w / h);
                console.log('targetWidth', targetWidth);
                if (targetWidth < 200)
                    targetWidth = 250;
                if (targetWidth > maxWidth)
                    targetWidth = maxWidth;
                $('.modal-video iframe').css('width', targetWidth + 'px');

                var fiid = item.attr('data-fiid');
                console.log(fiid);
                CallAjax('FolderImageActivities_SaveViewVideo', { collectionsGuid: $('[id$="hfCollectionsGuid"]').val(), folderImagesId: fiid }, loadVideoSuccess);
            }

            function loadVideoSuccess(results) {   
                var src = 'https://iframe.mediadelivery.net/embed/' + results.Library + '/' + results.VideosGuid + '?autoplay=false';
                $('.modal-video iframe').attr('src', src);
            }

            function modalVideo() {             
                ShowPageSpinner();   
                $('.modal-video iframe').attr('src', 'about:blank'); //reset
                $('.modal-video').show();
            }

            function hideVideo() {
                $('.modal-video').hide();
            }

            let videoTimer;
            $(document).ready(function () {
                $('.grid-container').toggle($('.grid-container-empty').is(':visible') == false);
                
                $('.cover-border').append($('.cover-title').clone());
                $('.cover-button').parent().addClass('cover-button-wrapper'); //ensure

                updateVideoSize();

                wasHorizontal = window.innerWidth < window.innerHeight;
                if(window.innerWidth <= 900) //only for non-desktop
                    setCoverHeight();

                setGalleryBody();


                //set up auto start/stop on hover
                //$('.video-item').each(function (i, v) {
                //    var iframe = $(v).find('iframe')[0];
                //    const wrapper = iframe.parentElement;
                //    const player = new playerjs.Player(iframe);
                //    var thumb = $(v).find('.video-thumb')[0];

                //    // Wait until the iframe signals it's ready
                //    player.on('ready', () => {
                //        thumb.addEventListener('mouseenter', () => {
                //            console.log('enter...');
                //            setTimeout(function () {
                //                player.play();
                //            }, 300);                            
                //        });

                //        thumb.addEventListener('mouseleave', () => {
                //            console.log('mouseleave...');
                //            //player.pause();
                //            //player.setCurrentTime(0);    // rewind (optional)

                //            //throttle rapid mouse movements version:
                //            clearTimeout(videoTimer);
                //            videoTimer = setTimeout(() => { player.pause(); player.setCurrentTime(0); }, 150);
                //        });
                //    });
                //});

                //set up auto start/stop on hover
                //$('.video-video iframe').each(function (i, v) {
                //    var iframe = $(v)[0];
                //    const wrapper = iframe.parentElement;
                //    const player = new playerjs.Player(iframe);

                //    // Wait until the iframe signals it's ready
                //    player.on('ready', () => {
                //        wrapper.addEventListener('mouseenter', () => player.play());

                //        wrapper.addEventListener('mouseleave', () => {
                //            //player.pause();
                //            //player.setCurrentTime(0);    // rewind (optional)

                //            //throttle rapid mouse movements version:
                //            clearTimeout(videoTimer);
                //            videoTimer = setTimeout(() => { player.pause(); player.setCurrentTime(0); }, 150);
                //        });
                //    });
                //});
            });

            $(window).load(function () {
                History.Adapter.bind(window, 'statechange', function () {
                    console.log('History statechange...');
                    jumpToShowImage();
                    //need to update photoswipe
                });
            });
            
            $(window).resize(function () {
                //$('.carousel-cell img').hide(); //temp

                setTimeout(function () {
                    updateVideoSize();

                    //sizeCells();
                    $('.carousel-cell img').show();
                }, 300);    
                
                var nowHorizontal = window.innerWidth < window.innerHeight;

                if (wasHorizontal != nowHorizontal) {
                    wasHorizontal = nowHorizontal;                    
                    setCoverHeight();
                }

                if (window.innerWidth < 900)
                    $('#divModalImage').removeClass('modal-flex');
                else if ($('[id$="hfModalFlex"]').val() == 'true')
                    $('#divModalImage').addClass('modal-flex');


                buildPriorityNav();
            });

            function triggerResize(){
                var event;
                if(typeof(Event) === 'function') {
                    event = new Event('resize');
                }else{
                    event = document.createEvent('Event');
                    event.initEvent('resize', true, true);
                }

                window.dispatchEvent(event);
            }

            function setCoverHeight() {
                $(window).scrollTop(0);
                $('.cover-border').css('height', window.innerHeight + 'px');

                // Additional timeOut for iPhone Plus in landscape with multiple tabs opened
                setTimeout(function () {
                    $('.cover-border').css('height', window.innerHeight + 'px');
                    $(window).scrollTop(0);
                }, 400);
            }

            function showImageLightbox(fiid) {
                var idx = arrayIndexOf(lightboxes, 'FoldersId', activeLightbox);
                lightboxData = lightboxes[idx].Items;
                thisFiid = fiid;

                console.log("fiid", fiid);
                console.log('idx', idx);
                console.log('lightboxData', lightboxData);

                if (carouselMode != 'lightbox') {
                    //reset activeData
                    activeData = JSON.parse(JSON.stringify(lightboxData));  //deep copy
                    //showModalImage(); //redundant, but necessary
                    initPhotoSwipe();
                    photoSwiper.init();
                }
                carouselMode = 'lightbox';

                
                var idx = arrayIndexOf(activeData, 'FolderImagesId', fiid);
                console.log('lightbox-item clicked', idx + ' ' + fiid);
                photoSwiper.loadAndOpen(idx);

                //showImage(fiid); //we don't want lightbox viewing as part of history
            }

            function showImageFolder(fiid) {
                console.log('folderData', folderData);
                
                if (carouselMode != 'folder') {
                    //reset activeData
                    activeData = JSON.parse(JSON.stringify(folderData));  //deep copy
                    //showModalImage(); //redundant, but necessary    
                    initPhotoSwipe();
                    photoSwiper.init();
                }
                carouselMode = 'folder';

                showImage(fiid);
            }

            function showImage(fiid) {
                console.log('showImage', fiid);

                if (typeof closeLightbox === 'function')
                    closeLightbox();

                pushHistory(fiid);  
            }

            function nthIndex(str, pat, n){
                var L= str.length, i= -1;
                while(n-- && i++<L){
                    i= str.indexOf(pat, i);
                    if (i < 0) break;
                }
                return i;
            }

            function pushHistory(fiid) {
                console.log('pushHistory');
                var basePath = getCollectionBasePath();
                var qs = window.location.search;

                //this statechange triggers jumpToShowImage:
                var path = basePath + (fiid || '') + qs;
                //console.log('path', path);
                History.pushState(null, null, path);              
            }

            //var initialImage = false;
            function jumpToShowImage() {
                console.log('jumpToShowImage');
                var url = window.location.pathname.replace(/\/\s*$/,'');
                var url_parts = url.split('/'); //replace any trailing "/"
                //console.log(url + ' has ' + url_parts.length + ' parts');

                var fiid = url_parts[url_parts.length - 1]; 
                console.log('fiid', fiid);
                var index = arrayIndexOf(activeData, 'FolderImagesId', fiid);// $('.grid-item[data-fiid="' + fiid + '"]').index(); //arrayIndexOf(activeData, 'FolderImagesId', f);
                //index = index - ($('.pig-figure').length ? 0 : 1); //remove grid-sizer


                console.log('jumpToShowImage index' , index);
                if (index >= 0) {
                    var i = (photoSwiper.pswp && photoSwiper.pswp.currSlide) ? photoSwiper.pswp.currSlide.index : -99;
                    console.log('currSlide', i);


                    if (index == i || i == -99) {
                        //console.log('pswp.currSlide', photoSwiper.pswp.currSlide.index);

                        photoSwiper.loadAndOpen(index);

                        //, { gallery: document.querySelector('#divGrid') }
                    }
                    else {
                        console.log('going to index', index);
                        photoSwiper.pswp.goTo(index);
                    }
                }
                else if (photoSwiper.pswp) {
                    photoSwiper.pswp.close();
                    $('#divImageDetails').removeClass('display');
                }                    
            }
        </script>

        <script type="text/javascript">
            function myFunction() {
                var m = $('#divHeaderMobile .menu-list');
                m.toggleClass('responsive');

                //var x = document.getElementById("menu");
                //if (x.className === "menu-list") {
                //    x.className += " responsive";
                //} else {
                //    x.className = "menu-list";
                //}
            }

            function getCollectionBasePath() {
                var url = window.location.href.replace(/\/\s*$/,''); //replace any trailing "/"
                var url_parts = url.split('/'); 

                var basePath = url;
                if(url_parts.length > 5){
                    var baseEnd = nthIndex(url + '/','/',5);
                    basePath = window.location.href.substring(0,baseEnd);
                }

                if(basePath.indexOf('?') > 0)
                    basePath = basePath.substring(0, basePath.indexOf('?'));

                //console.log('getCollectionBasePath', basePath);
                return basePath + '/';
            }

            function fnEllipsis(t, l) {
                t = t || '';
                if (t.length <= l)
                    return t;
                else {
                    var breakpoint = (l - 3) / 2;
                    return t.substring(0, breakpoint) + '...' + t.substring(t.length - breakpoint, t.length);
                }
            }

            function loadImageDetails(results) {

                //return;

                if (results.length === 0)
                    return;

                var obj = results[0];
                var i = arrayIndexOf(activeData,'FolderImagesId',obj.FolderImagesId);
                $('.details-counter').html((i + 1) + ' <span>of</span> ' + activeData.length);
                $('.details-title').html(obj.Title);
                $('.details-description').toggle(GetString(obj.Description) != '');
                $('.details-description .value').html(descriptionHtml(obj.Description));
                $('.details-date').html(GetString(obj.DateTakenString) != '' ? '<i class="fal fa-calendar"></i> ' + obj.DateTakenString : '');
                $('.details-filename').html(obj.OriginalFileName).toggle($('[id$="hfShowFileNames"]').val() == 'true');

                $('#aModalShare').click(function(){showShareImage(obj.FolderImagesId); return false;});
                $('#aModalCart').click(function () { if (typeof selectProductImage === 'function') { selectProductImage(obj.FolderImagesId); } return false; });

                $('.ps-button .fa-comments').toggleClass('value', obj.NumComments > 0);
                $('.ps-button .fa-eye-slash').toggleClass('value', obj.ClientHide);
                $('.ps-button-download').toggle(obj.AllowDownload);
                toggleModalSpecificCount(obj.FolderImagesId); // ImagesId);

                if (obj.VideosId == '') {
                    $('.ps-button-buy').show(); //#aModalCart
                    //$('.ps-button-download').show(); //#aModalDownload
                }
                else {
                    $('.ps-button-buy').hide(); //#aModalCart
                    //$('.ps-button-download').hide();
                }

                if (typeof setLightboxStatus === 'function')
                    setLightboxStatus(obj.FolderImagesId);

                //$('#aModalLike').toggleClass('value', obj.HasLike);
                //$('#aModalLightbox').toggleClass('value', obj.HasLightbox);
                //$('#aModalClientHide').toggleClass('value', obj.ClientHide);
                $('#aModalComments .value').remove();
                if (obj.NumComments > 0)
                    $('#aModalComments').append('<div class="value">' + obj.NumComments + '</div>');

                //saveLikeSuccess(results);

                var tags = '';
                var words = GetString(obj.Keywords).split(',');
                for (var x = 0; x < words.length; x++) {
                    if (words[x].length > 0) {
                        var path = words[x].trim().replace(/[^a-zA-Z\-\d\s]+/g, '').replace(/[\s]+/g, '-').toLowerCase();
                        tags += '<a href="/search/photos/' + path + '">' + words[x].trim() + '</a>';
                        //tags += '<a href="/search?q=' + words[x].trim() + '" onclick="searchTag(\'' + words[x].trim() + '\'); return false;">' + words[x].trim() + '</a>';
                    }
                }
                //$('.details-keywords').toggle(tags.length > 0);
                //$('.details-keywords .value').html(tags);
                if ($('[id$="hfAllowComments"]').val() == 'true')
                    bindComments(obj.NumComments);
            }

            $(document).ready(function () {

                if ($('[id$="hfModalFlex"]').val() == 'true') {
                    if (window.innerWidth < 900)
                        $('#divModalImage').removeClass('modal-flex');
                    else if ($('[id$="hfModalFlex"]').val() == 'true')
                        $('#divModalImage').addClass('modal-flex');
                }

                if($('[id$="pnlHolder"]').hasClass('dark'))
                    $('body').addClass('dark');

                if($('[id$="pnlHolder"]').hasClass('menu-vertical'))
                    $('body').addClass('vertical');

                $('.modal-body').on('click', function(){
                    if (isSliding) {
                        return;
                    }
                    else{
                        $('.modal-image').toggleClass('show-mobile-controls')
                    }
                });

                loadImageData();
            });

            var activeData = [];
            var folderData = [];
            var lightboxData = [];
            var carouselMode = 'folder';

            function loadImageData() {
                CallAjax('FolderImages_GetThumbs', { 'galleriesGuid': $('[id$="hfFoldersGuid"]').val() }, loadImageDataSuccess);
            }    

            function loadImageDataSuccess(results) {
                //var imagesOnly = results.Thumbs.filter(function (el) {
                //    return el.ImagesId; //excludes video for now
                //});
                folderData = results.Thumbs; // imagesOnly; // results.Thumbs;
                activeData = results.Thumbs; // imagesOnly; // results.Thumbs;

                $('[id$="pnlCart"]').load('/gallery/store.aspx?c=' + $('[id$="hfCollectionsGuid"]').val(), function(){ initStore();});

                if (typeof loadPigData === 'function') { // Pig !== 'undefined') {
                    var filtered = results.Thumbs.filter(function (el) { return el.ImagesId; });
                    results.Thumbs = filtered;
                    loadPigData(results);
                }
                //else {
                //    createStatsEvents();
                //}

                
                

                createStatsEvents();

                //document.getElementById('divGrid').addEventListener('click', function (event) {
                //    if (event.target && event.target.classList.contains('overlay')) {
                //        // Event triggered
                //        var fiid = event.target.parentNode.parentNode.getAttribute('data-fiid');

                //        if(document.getElementById('divGrid').classList.contains('showfull')){
                //            showFullImage(fiid);
                //        }
                //        else{
                //            showModalImage(); //redundant, but necessary
                //            buildCarousel(fiid);
                //            showImageFolder(fiid); //event.target.parentNode);
                //        }
                //    }
                //});
                setTimeout(function () {
                    setPhotoSwipeDimensions();
                    jumpToShowImage();
                }, 100);
            }

            function setPhotoSwipeDimensions() {
                //console.log('setPhotoSwipeDimensions', $('#divGrid .grid-item .wrapper img').length);

                $('#divGrid .grid-item .wrapper > img[data-height]').each(function (i, v) {
                    //console.log(i, $(v).attr('data-srcset'));
                    var img = $(v);
                    var src = img.attr('data-srcset') || img.attr('src') || '';
                    //console.log('src', src);
                    var bigsrc = src.replace('cdn2', 'cdn8'); //thumb to small
                    var h = img.attr('data-height');
                    var w = img.attr('data-width');
                    var a = $('<a href="' + src + '" data-pswp-src="' + bigsrc + '" data-pswp-width="' + w + '" data-pswp-height="' + h + '"></a>');
                    img.after(a);
                    //img.closest('.grid-item').attr('data-pswp-src', );
                });

                initPhotoSwipe();
                photoSwiper.init();
            }

            window.actionClicked = false;
            function createStatsEvents() {
                //var fiid = $(this).closest('.grid-item').attr('data-fiid');
                //thisFiid = fiid;
                //    saveLike(thisFiid);
                    
                //    return false;
                //});

                $('#divGrid,.videos').on('click', '.stats-comment a', function () {
                    var fiid = $(this).closest('.grid-item,.carousel-cell,.video-item').attr('data-fiid');
                    thisFiid = fiid;
                    showImageFolder(thisFiid);
                    setTimeout(function () {
                        showComments(thisFiid);
                    }, 500); //give image time to load
                    
                    return false;
                });

                $('#divGrid,.videos').on('click', '.stats-clienthide a', function () {
                    var fiid = $(this).closest('.grid-item,.carousel-cell,.video-item').attr('data-fiid');
                    thisFiid = fiid;
                    saveClientHide(thisFiid);
                    
                    return false;
                });

                $('#divGrid,.videos').on('click', '.stats-download a', function () {
                    var fiid = $(this).closest('.grid-item,.carousel-cell,.video-item').attr('data-fiid');

                    //thisIid = iid;
                    thisFiid = fiid;
                    console.log('download', thisFiid);

                    if ($(this).closest('.video-item').length > 0)
                        downloadVideo($(this));
                    else 
                        downloadImage(thisFiid);

                    return false;
                });

                $('#divGrid,.videos').on('click', '.stats-share a', function () {
                    var fiid = $(this).closest('.grid-item,.carousel-cell,.video-item').attr('data-fiid');
                    thisFiid = fiid;
                    showShareImage(thisFiid);

                    return false;
                });

                $('#divGrid').on('click', '.stats-cart a', function (event) {
                    var fiid = $(this).closest('.grid-item,.carousel-cell,.video-item').attr('data-fiid');
                    thisFiid = fiid;
                    if(typeof selectProductImage === 'function') //may not be loaded
                        selectProductImage(thisFiid);

                    console.log('preventing default', event);
                    //event.preventDefault();
                    window.actionClicked = true;
                    console.log('wac', window.actionClicked);
                    event.stopImmediatePropagation();

                    return false;
                });

                $('#divGrid,.videos').on('click', '.stats-lightbox a', function () {
                    var div = $(this).closest('.grid-item,.carousel-cell,.video-item');
                    //if(div.length == 0)
                    //    div = $(this).closest('.carousel-cell');
                    toggleComments(true);
                    processLightboxAction(div);

                    //if ($('[id$="hfUserName"]').val() == '' || lightboxes.length == 0) {
                    //    showLightbox();
                    //}
                    //else if (lightboxes.length == 1)
                    //    saveLightboxItem(div.attr('data-id'), lightboxes[0].LightboxesId, div.hasClass('lightbox-item'));
                    //else
                    //    loadLightboxItem(div.attr('data-id'));

                    return false;
                });

                $('#divGrid,.videos').on('click', '.grid-item,.video-item', function () {
                    var fiid = $(this).attr('data-fiid');

                    //could be a problem masonry vs all others
                    var idx = arrayIndexOf(activeData, 'FolderImagesId', fiid);
                    console.log('grid-item clicked', idx + ' ' + fiid);
                    //photoSwiper.loadAndOpen(idx);

                    showImageFolder(fiid);

                    return false;
                });
            }


            function decodeHtml(value){
                var s = $('<div/>').html(value).text();
                //console.log(s);
                return s;
            }
            
        </script>

        <script type="text/javascript">
            function saveClientHide(fiid) {
                fiid = (fiid == undefined ? thisFiid : fiid);
                CallAjax('FolderImageActivities_SaveClientHide', { 'collectionsGuid': $('[id$="hfCollectionsGuid"]').val(), 'folderImagesId': fiid }, saveClientHideSuccess);
            }

            function saveClientHideSuccess(results) {
                var obj = results[0];
                var div = $('.grid-item[data-fiid="' + obj.FolderImagesId + '"]');
                if (div.length == 0)
                    div = $('.carousel-cell[data-fiid="' + obj.FolderImagesId + '"]');

                if (obj.ClientHide) {
                    div.find('.details-selected .details-clienthide').addClass('value');
                }
                else {
                    div.find('.details-selected .details-clienthide').removeClass('value');
                }

                div.find('.stats-clienthide').toggleClass('value', obj.ClientHide);
                $('.ps-button .fa-eye-slash').toggleClass('value', obj.ClientHide);
            }


            function downloadVideo(c) {
                window.open(c.attr('data-url'), '_blank');
                CallAjax('FolderImageActivities_SaveDownload', { 'collectionsGuid': $('[id$="hfCollectionsGuid"]').val(), folderImagesId: thisFiid, tokensId: '' }, function () { }); //function (results) { downloadVideoSuccess(results, c);
                return false;
            }

            function downloadVideoSuccess(results, c) {
                if (results.Status == 'valid' || results.Status == 'valid pin')
                    window.open(c.attr('data-url'), '_blank');
                else 
                    toastr.error(results.Status || 'Download Failed');
            }

            function downloadImage(fiid) {     
                singleImagesId = fiid;

                if ($('[id$="hfDownloadSpecific"]').val() == 'true') {
                    singleImagesId = '';
                    //var fiid = activeData[arrayIndexOf(activeData, 'ImagesId', iid)].FolderImagesId;
                    saveSpecificSelection(fiid, $('.ps-button .fa-arrow-down-to-line')); //showDownloadSpecific(); //#aModalDownload
                }
                else if ($('[id$="hfDownloadImageRequiresEmail"]').val() == 'true') {   
                    showDownloadGallery(true);
                }
                else {
                    if (typeof showDestination === 'function') {
                        showDestination(true);
                    }
                    else {
                        downloadRequestTypesId = 1566;
                        startSingleDownload();
                    }  
                }                
            }


            var isFetchingIosImage = false;
            async function fetchIosImage(results) {
                if (isFetchingIosImage)
                    return; //prevent multiple calls

                isFetchingIosImage = true;

                var url = '/gallery/downloadios/?guid=' + results.Guid;
                const response = await fetch(url);
                const reader = response.body.getReader();
                let base64Data = '';

                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;
                    base64Data += new TextDecoder().decode(value);
                }

                //set base 64;
                $('#imgIosDownload').attr('src', base64Data);
                isFetchingIosImage = false; //reset
                $('#aIosDownload').show();
            }

            function startSingleDownload() {
                if (downloadRequestTypesId == 1566) {
                    var l = $('#bDeliverEmail').ladda();
                    l.ladda('start');
                }
                var tokensId = downloadRequestTypesId == 1567 ? (googleTokensId || '') : '';
                CallAjax('FolderImageActivities_SaveDownload', { 'collectionsGuid': $('[id$="hfCollectionsGuid"]').val(), folderImagesId: singleImagesId, tokensId: tokensId }, startSingleDownloadSuccess);
            }

            function startSingleDownloadSuccess(results) {
                console.log('results', results);
                if (results.TokenFailed) {
                    googleTokensId = ''; //reset
                    Ladda.stopAll();
                    toastr.error(results.Status || 'Request failed');
                    return;
                }
                //else if (results.Success == false) {
                //    alert(results.Status);
                //    return;
                //}

                switch(results.Status){
                    case 'valid':
                    case 'valid pin':
                        //console.log('navigator.userAgent', navigator.userAgent);
                        //if (/CriOS/i.test(navigator.userAgent) && /iphone|ipod|ipad/i.test(navigator.userAgent)) //chrome ios
                        if (downloadRequestTypesId == 1567) {
                            //already processed, nothing to do
                            $('#divDownloadDestination').hide();
                            $('#divDownloadReadyGoogle').show();
                        }
                        else if (/iphone|ipod|ipad/i.test(navigator.userAgent) && (results.VideosId || '') == '') //any ios
                        {
                            $('#imgIosDownload').attr('src', '/assets/images/eclipse-spinner.gif'); //resets
                            $('[id$="pnlDownloads"]').show();
                            $('#divDownloadStart').hide();
                            $('#divDownloadDestination').hide();
                            $('#aIosDownload').hide();
                            isFetchingIosImage = false; //reset
                            $('#divDownloadIos').show();

                            fetchIosImage(results);
                            //window.location = '/gallery/downloadpage/?guid=' + results.Guid;
                        }                            
                        else {
                            window.open('/gallery/download/?guid=' + results.Guid);
                            cancelDownloadGallery();
                        }                            
                        break;
                    case 'pin required':
                        $('#AfterPinAction').val(results.FolderImagesId);
                        $('#divModalImage').hide();
                        showPinForm();
                        break;
                    case 'login required':
                        $('#divModalImage').hide();
                        showPinLoginRequired();
                        break;
                    default:
                        Ladda.stopAll();
                        toastr.error(results.Status || 'Download Failed');
                        break;
                }                
            }

            var autoplayOn = false;
            function toggleAutoplay(forceReset) {
                //if (thisSlick == undefined)
                //    return;

                if (forceReset == true) {
                    $('.ps-button-autoplay i').attr('class', 'fal fa-fw fa-play');
                    //$('#divImageDetails').removeClass('display'); //force closure
                }
                else if (autoplayOn) {
                    $('.ps-button-autoplay i').attr('class', 'fal fa-fw fa-play');
                }                    
                else {
                    $('.ps-button-autoplay i').attr('class', 'fal fa-fw fa-pause');
                    $('#divImageDetails').removeClass('display'); //force closure  
                }                    

                if (forceReset == true && autoplayOn == false) { }
                else 
                    psSlideshow.setSlideshowState();
                autoplayOn = forceReset ? false : !autoplayOn;
            }

            //function saveLike(id) {
            //    if (navigator.cookieEnabled) {
            //        id = (id == undefined ? $('.slick-current').attr('data-id') : id);
            //        CallAjax('FolderImageActivities_SaveLike', { 'collectionsGuid': $('[id$="hfCollectionsGuid"]').val(), 'folderImagesId': id }, saveLikeSuccess);
