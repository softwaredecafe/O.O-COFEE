            //    var div = $('.grid-item[data-id="' + obj.FolderImagesId + '"]');
            //    if(div.length == 0)
            //        div = $('.carousel-cell[data-id="' + obj.FolderImagesId + '"]');

            //    if(obj.NumLikes > 0){
            //        div.find('.details-selected .details-like span').html(obj.NumLikes);
            //        //$('#spnLikeCount').html(obj.NumLikes).show();
            //        div.find('.details-selected .details-like').addClass('value');
