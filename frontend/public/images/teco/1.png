<script type="text/javascript">
    

    function toggleModalLightboxCount(fiid) {
        var div = $('.grid-item[data-fiid="' + fiid + '"],.video-item[data-fiid="' + fiid + '"]');
        var iid = div.attr('data-iid');
        var vid = div.attr('data-vid');
        console.log('toggleModalLightboxCount', iid);
        console.log('toggleModalLightboxCount', vid);
        var ct = 0;
        for (var x = 0; x < lightboxes.length; x++) {
            for (var y = 0; y < lightboxes[x].Items.length; y++) {
                if (lightboxes[x].Items[y].ImagesId == iid || lightboxes[x].Items[y].VideosId == vid)
                    ct++;
            }
        }
        console.log('toggleModalLightboxCount lightboxes', lightboxes);
        console.log('toggleModalLightboxCount ct', ct);

        $('.ps-button-lightbox').toggleClass('value', ct > 0);
    }

    function setLightboxStatus(fiid) {
        var div = $('.grid-item[data-fiid="' + fiid + '"]');
        if (div.length == 0)
            div = $('.carousel-cell[data-fiid="' + fiid + '"]');

        if (div.length == 0)
            div = $('.video-item[data-fiid="' + fiid + '"]');

        toggleModalLightboxCount(fiid);

        //if (div.hasClass('lightbox-item') != $('#aModalLightbox').hasClass('value'))
        //    $('#aModalLightbox').toggleClass('value', !div.hasClass('lightbox-item'));
    }



    function bindAssociatedList(fiid) {
        var div = $('.grid-item[data-fiid="' + fiid + '"],.video-item[data-fiid="' + fiid + '"]');
        var iid = div.attr('data-iid');
        var vid = div.attr('data-vid');

        var selectList = [];
        for (var x = 0; x < lightboxes.length; x++) {
            var folderImagesId = '';
            for (var y = 0; y < lightboxes[x].Items.length; y++) {
                if (lightboxes[x].Items[y].ImagesId == iid || lightboxes[x].Items[y].VideosId == vid)
                    folderImagesId = lightboxes[x].Items[y].FolderImagesId;
            }

            var obj = {};
            obj.FolderName = lightboxes[x].FolderName;
            obj.FoldersId = lightboxes[x].FoldersId;
            obj.FolderImagesId = folderImagesId;
            selectList.push(obj);
        }

        var source = $("#associated-list-template").html();
        var template = Handlebars.compile(source);
        var data = { 'items': selectList }; //lightboxes };
        $(".select-list").html(template(data));
    }

    function toggleLightboxAssociation(lbid, fiid, a) {
        //fiid = fiid || $('#LightboxItemCandidateId').val(); 

        if ($(a).closest('li').hasClass('value')) {
            removeLightboxAssociation(fiid); //iid
            $(a).closest('li').removeClass('value');
        }
        else {
            var idx = arrayIndexOf(lightboxes, 'FoldersId', lbid);

            //check for max
            if (lightboxes[idx].Items.length + 1 > lightboxes[idx].LightboxMaxImages && lightboxes[idx].LightboxMaxImages > 0) {
                toastr.error('You have already selected the maximum number of images (' + lightboxes[idx].LightboxMaxImages + ') for this favorites list');
            }
            else {
                addLightboxAssociation(lbid, $('#LightboxItemCandidateId').val());
                $(a).closest('li').addClass('value');
            }            
        }
    }

    function addLightboxAssociation(lbid, fiid ) {
        CallAjax('FolderImages_SaveLightbox', { foldersId: lbid, folderImagesId: fiid }, toggleLightboxAssociationSuccess);
    }

    function removeLightboxAssociation(fiid) { 
        CallAjax('FolderImages_DeleteLightbox', { folderImagesId: fiid }, toggleLightboxAssociationSuccess);
    }

    function toggleLightboxAssociationSuccess(results) {
        if (results.Success == false && results.Message)
            alert(results.Message);

        loadLightboxes();
    }

    function removeLightboxItem(fiid, div) {
        //var lbid = $('#ActiveLightboxesId').val();
        CallAjax('FolderImages_DeleteLightbox', { folderImagesId: fiid }, function (results) { removeLightboxItemSuccess(results, div); });
    }

    function removeLightboxItemSuccess(results, div) {
        if (results.Success) {
            $(div).closest('li').remove();

            loadLightboxes($('#ActiveLightboxesId').val()); //lbid
        }
        else if (results.Message) {
            alert(results.Message);
        }
        else {
            //not authenticated
            showLightbox(true);
        }
    }

    


    function saveLightboxItem(fiid, lbid, active) {
        if ($('[id$="hfUserName"]').val() == '')
            showLightbox();
        //else if ($('#FilterLightboxesId option').length == 0){
        //    showLightbox();
        //}
        else {
            if (active) {
                CallAjax('FolderImages_DeleteLightbox', { folderImagesId: fiid }, function (results) { saveLightboxItemSuccess(results, fiid, lbid); }); //'folderImagesId': fiid 
            }
            else {
                var idx = arrayIndexOf(lightboxes, 'FoldersId', lbid);

                //check for max
                if (lightboxes[idx].Items.length + 1 > lightboxes[idx].LightboxMaxImages && lightboxes[idx].LightboxMaxImages > 0) {
                    toastr.error('You have already selected the maximum number of images (' + lightboxes[idx].LightboxMaxImages + ') for this favorites list');
                }
                else {
                    CallAjax('FolderImages_SaveLightbox', { foldersId: lbid, folderImagesId: fiid }, function (results) { saveLightboxItemSuccess(results, fiid, lbid); });
                }
            }
        }
    }    

    function saveLightboxItemSuccess(results, fiid, lbid) {
        if (results.Success) {
            var div = $('.grid-item[data-fiid="' + fiid + '"]', '.carousel-cell[data-fiid="' + fiid + '"]', '.video-item[data-fiid="' + fiid + '"]');

            if (results.ImagesId) {
                var iid = results.ImagesId;
                div = $('.grid-item[data-iid="' + iid + '"]', '.carousel-cell[data-iid="' + iid + '"]', '.video-item[data-iid="' + iid + '"]');
            }
            
            console.log('div', div);
            console.log('fiid', fiid);
            div.toggleClass("lightbox-item").toggleClass('lightbox-item-' + lbid);
            $('.ps-button-lightbox').toggleClass('value');

            loadLightboxes(); //$('#ActiveLightboxesId').val()
            //$('[id$="hfNumLightboxItems"]').val(results.NumImages);
            //updateLightboxCount();
        }
        else if (results.Message) {
            alert(results.Message);
        }
        else {
            //not authenticated
            showLightbox(true);
        }
    }

    function callLightbox() {
        console.log('callLightbox');
        var div = $('.grid-item[data-fiid=' + thisFiid + ']');
        if (div.length == 0)
            div = $('.grid-item[data-iid=' + thisIid + ']');

        if (div.length == 0)
            div = $('.video-item[data-fiid=' + thisFiid + ']');

        processLightboxAction(div);

        toggleModalLightboxCount(thisFiid);
    }

    function processLightboxAction(div) {
        console.log('processLightboxAction', div);
        console.log('selectedLightbox', selectedLightbox);

        if ($('[id$="hfUserName"]').val() == '' || lightboxes.length == 0) {
            showLightbox();
        }
        else if ((selectedLightbox || '') != '' || lightboxes.length == 1) {
            var active = (div.hasClass('lightbox-item') && (selectedLightbox || '') == '')
                || div.hasClass('lightbox-item-' + selectedLightbox)
                || ($('.pswp').is(':visible') && $('.ps-button-lightbox').hasClass('value'));
            console.log('active', active);
            console.log('selectedLightbox', selectedLightbox);
            console.log('lightboxes', lightboxes);
            var fiid = div.attr('data-fiid');
            var lb = selectedLightbox || lightboxes[0].FoldersId;
            var idx = arrayIndexOf(lightboxes, 'FoldersId', lb);
            console.log('lb', lb);
            console.log('idx', idx);
            if (active) {
                var iid = div.attr('data-iid');
                var vid = div.attr('data-vid');
                var x = iid ? arrayIndexOf(lightboxes[idx].Items, 'ImagesId', iid)
                    : arrayIndexOf(lightboxes[idx].Items, 'VideosId', vid);
                fiid = lightboxes[idx].Items[x].FolderImagesId;
            }
            saveLightboxItem(fiid, lb, active); 
        }            
        else
            loadLightboxAssociations(div.attr('data-fiid'));
    }
</script>

<script type="text/javascript">
    function addLightboxContact() {
        $('.add-lb-contact').clearForm();
        //$('#LcShareMessage').html(lightboxShareMessage); //default
        Ladda.stopAll();

        if (vLightboxContact) {
            console.log('resetting');
            vLightboxContact.resetForm();
            vLightboxContact.reset();
        }

        $('#AddIsAdmin2').prop('checked', true); //default is normal
        //$('.lightbox-body').hide();
        $('.edit-lb-contact').hide();
        $('.add-lb-contact').show();
    }

    function addLightboxEmployee() {
        $('.add-lb-employee').show();
    }

    function loadLightboxContact(i) {
        $('#EditIsAdmin2').prop('checked', true); //default is normal

        //$('.lightbox-body').hide();
        $('.edit-lb-contact').show();
        $('.add-lb-contact').hide();
        CallAjax('FolderContacts_GetById', { 'folderContactsId': i }, loadLightboxContactSuccess);
    }

    function loadLightboxContactSuccess(results) {
        if (results.data.length || results.Success) {
            var obj = results.data[0];
            $('#LightboxContactsId').val(obj.FolderContactsId);
            $('.edit-lb-contact h5').html((obj.FirstName ? obj.FirstName + ' ' + obj.LastName + '<br />' : '') + obj.Email);
            if (obj.IsAdmin)
                $('#EditIsAdmin1').prop('checked', true);
            else
                $('#EditIsAdmin2').prop('checked', true);
        }
        else {
            //not authenticated
            showLightbox(true);
        }
    }

    function validateEmailAddress(e) {
        var re = /^\S+@\S+[\.][0-9a-z]+$/;
        return re.test(e);
    }

    var vLightboxContact;
    function validateLightboxContact(emails) {
        if (vLightboxContact)
            vLightboxContact.resetForm();

        vLightboxContact = $('.add-lb-contact .lb-contact-form').createValidator();
        var valid = RunValidation(vLightboxContact);

        //console.log('validating emails...');

        if (valid) {
            //var emails = $('#LcEmail').val();        
            //emails = emails.split(';');

            for (var x = 0; x < emails.length; x++) {                
                if (validateEmailAddress(emails[x]) == false) {
                    toastr.error(emails[x] + ' is not a valid email');
                    valid = false;
                }
            }
        }

        return valid;
    }

    function saveLightboxContact() {
        var emails = $('#LcEmail').val();
        emails = emails.replace(',', ';').replace(/;\s*$/, "").replace(/\s/g, '');
        $('#LcEmail').val(emails);
        emails = emails.split(';');

        //console.log('emails', emails);

        if (validateLightboxContact(emails)) {
            var l = $('#aCreateLc').ladda();
            l.ladda('start');

            CallAjax('FolderContacts_Save', { foldersId: $('#ActiveLightboxesId').val(), emailList: $('#LcEmail').val(), customMessage: '', isAdmin: $('#AddIsAdmin1').prop('checked') }, function (results) { saveLightboxContactSuccess(results, emails); }, saveLightboxContactFailure);
        }
    }

    function saveLightboxContactSuccess(results, emails) { 
        Ladda.stopAll();

        if (results.Success) {
            showLightboxItems();
            bindLightboxContacts($('#ActiveLightboxesId').val());
            toastr.success('Invite sent to ' + (emails.length == 1 ? emails[0] : emails.length + ' email addresses'));
        }
        else {
            //not authenticated
            showLightbox(true);
        }
    }

    function saveLightboxContactFailure() {
        Ladda.stopAll();
        alert('Unable to add user');
    }

    function saveLightboxEmployee() {
        CallAjax('FolderContacts_SaveEmployee', { foldersId: $('#ActiveLightboxesId').val() }, saveLightboxEmployeeSuccess);
    }

    function saveLightboxEmployeeSuccess(results) {
        showLightboxItems();
        invite.Invited = true;
        $('.invite-instructions').html(invite.Invited ? invite.Confirmation : invite.Instructions);
        $('#aCreateLe').closest('div').hide();
        $('#aCancelLe').html(invite.Invited ? 'Close' : 'Cancel');
        toastr.success(invite.Confirmation);
    }

    function updateLightboxContact() {
        CallAjax('FolderContacts_SaveIsAdmin', { foldersId: $('#ActiveLightboxesId').val(), folderContactsId: $('#LightboxContactsId').val(), isAdmin: $('#EditIsAdmin1').prop('checked') }, saveLightboxContactSuccess);
    }

    function deleteLightboxContact() {
        if (confirm('Are you sure?'))
            CallAjax('FolderContacts_Delete', { foldersId: $('#ActiveLightboxesId').val(), folderContactsId: $('#LightboxContactsId').val() }, deleteLightboxContactSuccess);
    }

    function deleteLightboxContactSuccess(results) {
        if (results.Success) {
            showLightboxItems();
            bindLightboxContacts($('#ActiveLightboxesId').val());
        }
        else {
            //not authenticated
            showLightbox(true);
        }
    }


    function bindLightboxContacts(i) {
        CallAjax('FolderContacts_GetByFolder', { 'foldersId': i }, bindLightboxContactsSuccess);
    }

    function bindLightboxContactsSuccess(results) {
        if (results.length || results.Success) {
            var source = $("#lightbox-contacts-template").html();
            var template = Handlebars.compile(source);
            var data = { 'items': results.data };
            $(".lightbox-contacts").html(template(data));            

            source = $("#lightbox-contacts-mobile-template").html();
            template = Handlebars.compile(source);
            data = { 'items': results.data };
            $(".lightbox-contacts-mobile").html(template(data));   

            $('.lightbox-invite-others').toggle(invite.InviteOthers == true);
            $('.lightbox-invite-me').toggle(invite.InviteMe == true);
            $('.invite-button-text').html(invite.ButtonText);
            $('.invite-instructions').html(invite.Invited ? invite.Confirmation : invite.Instructions);
            $('#aCancelLe').html(invite.Invited ? 'Close' : 'Cancel');
            $('#aCreateLe').closest('div').toggle(!invite.Invited);

            $(".lightbox-contacts").removeClass('readonly');

            if (results.IsAdmin == false) {
                $(".lightbox-contacts").addClass('readonly');
                $(".lightbox-contacts a").attr('onclick', 'return false;');
                $('.lightbox-invite-others').hide();
            }
        }
        else {
            //not authenticated
            showLightbox(true);
        }
    }
</script>

<script type="text/javascript">
    var lastSourceFolder;
    Handlebars.registerHelper("hbLightboxSourceFolder", function (data) {
        var ret = '';
        if (lastSourceFolder != data.SourceFoldersId)
            ret = '<li class="source-folder"><div><i class="fal fa-folder fa-fw"></i> ' + data.SourceFolderName + '</div><div id="divMaxImages"></div></li>';

        lastSourceFolder = data.SourceFoldersId;
        return ret;
    });

    function showLightboxItems() {
        //$('.lightbox-body').show();
        $('.edit-lb-contact').hide();
        $('.add-lb-contact').hide();
        $('.add-lb-employee').hide();
    }

    var activeLightbox;
    function loadLightboxItems(i) {
        activeLightbox = i;
        $('#ulLightboxItems .active').removeClass('active');
        $('.lightbox-comments-content').hide();
        showLightboxItems();

        var idx = arrayIndexOf(lightboxes, 'FoldersId', i);
        $('#divLightboxes').html(lightboxes[idx].FolderName + ' <i class="fal fa-chevron-down"></i>');

        displayLightboxSubmitted(lightboxes[idx]);

        $('.lightbox-mobile-list-name span').html(lightboxes[idx].FolderName);
        console.log('loadLightboxItems', i);
        $('#ActiveLightboxesId').val(activeLightbox);
        //CallAjax('LightboxItems_GetByLightbox', {'lightboxesId': i}, loadLightboxItemsSuccess);

        lastSourceFolder = ''; //reset
        var filtered = lightboxes.filter(
            function (lb) {
                return lb.FoldersId == i;
            }
        )[0];

        var source = $("#lightbox-items-template").html();
        var template = Handlebars.compile(source);
        var data = { 'items': filtered.Items };
        $("#ulLightboxItems").html(template(data));

        $('#ulLightboxes .selected').removeClass('selected');
        $('#ulLightboxes li[data-id="' + i + '"]').addClass('selected');

        $('#divMaxImages').html(lightboxes[idx].LightboxMaxImages > 0 ? '<i class="fal fa-circle-info fa-fw"></i> You\'ve selected ' + lightboxes[idx].Items.length + ' of ' + lightboxes[idx].LightboxMaxImages + ' images' : '');

        tippy.hideAll();

        if (invite.EnableComments) {
            $('.lightbox-body').addClass('comments');
            //bindLightboxComments();
        }

        
            
        if(i)
            bindLightboxContacts(i);
    }


    function loadLightboxAssociations(fiid) {
        console.log('loadLightboxItem fiid', fiid);
        var idx = arrayIndexOf(folderData, 'FolderImagesId', fiid); //imageData
        
        $('#LightboxItemCandidateId').val(fiid);

        console.log('folderData[idx]', folderData[idx]);
        var src = GetCdnImagePath(folderData[idx].LatestFileName || folderData[idx].FileName, 'cdn2');
        if (folderData[idx].VideosId)
            src = folderData[idx].SrcSet.replace(/\.[^/.]+$/, '.jpg');
        $('#divAssociatedLists .image img').attr('src', src);
        //showLightbox();

        $('.lightbox-modal').show();
        $('#divLightboxScreen').hide();
        $('#divLightboxScreen .lightbox-frame').hide();

        
        bindAssociatedList(fiid);


        $('#divAssociatedLists').show();
        $('#divLightboxEmail').hide();
        //$('#LightboxEmail').focus();//bad for mobile
        $('#divLightboxSignIn').hide();
        $('#divLightboxCreateAccount').hide();
    }

    function loadLightboxDetails(i, c) {
        $('#ulLightboxItems li').removeClass('active');
        $(c).closest('li').addClass('active');

        thisFiid = i;

        showMobileDetails();
        CallAjax('FolderImages_GetDetails', { collectionsGuid: $('[id$="hfCollectionsGuid"]').val(), folderImagesId: i }, loadlightboxDetailsSuccess);
    }

    function loadlightboxDetailsSuccess(results) {
        var obj = results.data[0];
        $('#spnFavoriteFileName').html(obj.OriginalFileName);
        $('#aFavoriteFile').attr('onclick', 'showImageLightbox("' + obj.FolderImagesId + '"); return false;');

        $('.lightbox-mobile-file-name').html(obj.OriginalFileName);
        $('.lightbox-mobile-image img').attr('src', 'https://cdn2.lightfolio.com/' + $('#MyPublicFolder').val() + '/' + (obj.LatestFileName || obj.FileName));
        
        bindLightboxCommentsSuccess(results.Comments);        
    }

    var lightboxes = [];
    var selectedLightbox;
    var tippyLightboxMenu;
    var tippyLightboxList;

    function loadLightboxes(i, show) {
        CallAjax('Folders_GetLightboxes', { 'collectionsGuid': GetString($('[id$="hfCollectionsGuid"]').val()) }, function (results) { loadLightboxesSuccess(results, i, show); });
    }

    function loadLightboxesSuccess(results, i, show) {
        $('.lightbox-count .count').remove(); //reset

        if (results.data.length || results.Success) {
            lightboxes = results.data || [];
            $('.header-action-lightboxes').removeClass('value');

            var source = $("#lightboxes-template").html();
            var template = Handlebars.compile(source);
            var data = { 'items': results.data };
            $("#ulLightboxes").html(template(data));

            $('#ulLightboxItems').html(''); //reset

            

            //console.log('lightboxes.length', lightboxes.length);
            var numFaves = 0;
            var menuItems = '';
            for (var x = 0; x < lightboxes.length; x++) {
                numFaves += lightboxes[x].NumImages + lightboxes[x].NumVideos;
                menuItems += '<li data-id="' + lightboxes[x].FoldersId + '" class="' + ((selectedLightbox) == lightboxes[x].FoldersId ? 'active ' : '') + '"><a href="#" onclick="setSelectedLightbox(this); return false;"><i class="fal fa-fw fa-star"></i> ' + lightboxes[x].FolderName + ' (' + (lightboxes[x].NumImages + lightboxes[x].NumVideos) + ')</a></li>';
            }
            menuItems = '<li class="dropdown-header">Active lightbox</li><li data-id="" class="' + ((selectedLightbox || '') == '' ? 'active' : '') + '"><a href="#" onclick="setSelectedLightbox(this); return false;"><i class="fal fa-fw fa-star"></i> None</a></li>' + menuItems;

            //console.log('numFaves', numFaves);
            if (numFaves > 0) {
                $('.lightbox-count').append('<div class="count">' + numFaves + '</div>');
            }

            if (invite.AllowActive) {
                //$('.lightbox-count').prepend('<div class="active-lightbox"><a href="#" onclick="return false;"><i class="far fa-chevron-circle-down"></i></a></div>');

                //$('.header-action-lightboxes').attr('onclick', 'return false;');
                var lightboxMenu = 
                    '<ul class="lightbox-menu lightbox-tippy-list">' +                    
                    '<li><a href="#" onclick="showLightbox(); return false;"><i class="fal fa-fw fa-cog"></i> Manage favorites</a></li> ' +
                    '<li class="divider"></li> ' +
                    menuItems +
                    '</ul>';

                $('.lightbox-count a').attr('onclick', 'return false;');

                if (tippyLightboxMenu == undefined) {
                    tippyLightboxMenu = tippy('.lightbox-count', {
                        content: lightboxMenu,
                        interactive: true,
                        placement: 'bottom',
                        trigger: 'click',
                        hideOnClick: true,
                        theme: 'light'
                    })[0];
                }
                else {
                    tippyLightboxMenu.setContent(lightboxMenu);
                }
            }

            console.log('tippyLightboxList', tippyLightboxList);
            //console.log('template(data)', template(data));

            if (tippyLightboxList == undefined) {
                tippyLightboxList = tippy('#divLightboxes', {
                    content: template(data),
                    interactive: true,
                    placement: 'bottom',
                    trigger: 'click',
                    hideOnClick: true,
                    theme: 'light'
                })[0];
            }
            else {
                tippyLightboxList.setContent(template(data));
            }
                

            if (lightboxes.length == 0) { //$('[id$="hfUserName"]').val()
                $('.lightbox-first').show();
            }
            else {
                $('.lightbox-first').hide();
                $('#ActiveLightboxesId').val(lightboxes[0].FoldersId);  //default to first

                $('.header-action-lightboxes').addClass('value');

                //$('.grid-item,.carousel-cell').removeClass('lightbox-item'); //reset
                $('.grid-item,.carousel-cell,.video-item').removeClass(function (index, css) {
                    return (css.match(/\blightbox\S+/g) || []).join(' '); // remove any class starting with "lightbox"
                });

                //console.log('lightboxes', lightboxes);
                highlightSelectedThumbs();                

                if (i === undefined || i == null) {
                    //console.log('results.data[0].FoldersId', results.data[0].FoldersId);
                    loadLightboxItems(results.data[0].FoldersId);
                }
                else {
                    console.log('i', i);
                    loadLightboxItems(i);
                }
            }

            var fiid = $('#LightboxItemCandidateId').val();
            if (fiid) {
                toggleModalLightboxCount(fiid);
                bindAssociatedList(fiid);
            }            

            if (show == true && (GetQueryString('lbx') == 'true' || $('[id$="hfShowLightbox"]').val() == 'true')) {
                showLightbox();
                if (lightboxes.length > 0) {
                    loadLightboxItems(lightboxes[0].FoldersId);
                    bindLightboxContacts(lightboxes[0].FoldersId);
                }                    
            }
            else if (show)
                bindLightboxContacts($('#ActiveLightboxesId').val());

            if (carouselMode == 'lightbox') {
                carouselMode = 'folder'; //effectively resets lightbox carousel
            }
        }
        else if (results.Success == false) {
            //not authenticated
            showLightbox(true);
        }

        toggleSelectedLightboxItem();

        if (typeof setFavorites === 'function') {
            setFavorites();
        }
    }

    function highlightSelectedThumbs() {
        for (var x = 0; x < lightboxes.length; x++) {
            for (var y = 0; y < lightboxes[x].Items.length; y++) {
                $('.grid-item[data-iid="' + lightboxes[x].Items[y].ImagesId + '"]').addClass('lightbox-item lightbox-item-' + lightboxes[x].FoldersId);
                $('.video-item[data-vid="' + lightboxes[x].Items[y].VideosId + '"]').addClass('lightbox-item lightbox-item-' + lightboxes[x].FoldersId);
                $('.carousel-cell[data-iid="' + lightboxes[x].Items[y].ImagesId + '"]').addClass('lightbox-item lightbox-item-' + lightboxes[x].FoldersId);
                $('.search-item[data-iid="' + lightboxes[x].Items[y].ImagesId + '"]').addClass('lightbox-item lightbox-item-' + lightboxes[x].FoldersId);
            }
        }
    }

    function setSelectedLightbox(a) {
        $('.lightbox-menu > li').removeClass('active');
        $(a).closest('li').addClass('active');
        selectedLightbox = $('.lightbox-menu > li.active').attr('data-id');
        toggleSelectedLightboxItem();
        tippy.hideAll();
    }

    function toggleSelectedLightboxItem() {
        //$('.grid-item,.carousel-cell,.search-item').css('opacity', 1); //reset
        $('.grid-item,.carousel-cell,.search-item').removeClass('filtered-item');

        //console.log('toggling selectedLightbox', selectedLightbox);
        if ((selectedLightbox || '') != '') {
            $('.grid-item:not(.lightbox-item-' + selectedLightbox + ')').addClass('filtered-item'); //.css('opacity', .1);
            $('.video-item:not(.lightbox-item-' + selectedLightbox + ')').addClass('filtered-item'); //.css('opacity', .1);
            $('.carousel-cell:not(.lightbox-item-' + selectedLightbox + ')').addClass('filtered-item'); //css('opacity', .1);
            $('.search-item:not(.lightbox-item-' + selectedLightbox + ')').addClass('filtered-item'); //css('opacity', .1);
        }
    }

    function modalAeLightbox(edit) {
        $('#ActiveLightboxesId').val('');
        if (edit)
            $('#divAeLightbox h2').html('Edit Lightbox');
        else
            $('#divAeLightbox h2').html('Create a Lightbox');

        $('#divAeLightbox').clearForm();
        $('#divAeLightbox').show();
        //$('#LightboxName').val('').focus(); //bad for mobile
    }

    function hideAeLightbox() {
        $('#divAeLightbox').hide();
    }

    function editAeLightbox(i) {
        CallAjax('Folders_GetById', { 'foldersId': i }, editAeLightboxSuccess);
    }

    function editAeLightboxSuccess(results) {
        if (results.data.length || results.Success) {
            modalAeLightbox(true);

            var obj = results.data[0];
            $('#ActiveLightboxesId').val(obj.FoldersId);
            $('#LightboxName').val(obj.FolderName);
        }
        else if (results.Success == false) {
            //not authenticated
            showLightbox(true);
        }
    }

    function validateCreateAeLightbox() {
        var v = $('#divAeLightbox').createValidator();
        return RunValidation(v);
    }

    function createAeLightbox() {
        if (validateCreateAeLightbox())
            CallAjax('Folders_SaveLightbox', { 'foldersId': $('#ActiveLightboxesId').val(), 'collectionsGuid': GetString($('[id$="hfCollectionsGuid"]').val()), 'folderName': $('#LightboxName').val() }, createAeLightboxSuccess);
    }

    function createAeLightboxSuccess(results) {
        if (results.Success) {
            hideAeLightbox();
            loadLightboxes(results.FoldersId);
        }
        else {
            //not authenticated
            showLightbox(true);
        }
    }

    function deleteAeLightbox(i) {
        if (confirm('Are you sure?'))
            CallAjax('Folders_DeleteLightbox', { 'foldersId': i }, function (results) { deleteAeLightboxSuccess(results, i); });
    }

    function deleteAeLightboxSuccess(results, i) {
        if (results.Success) {
            i = (i == $('#ActiveLightboxesId').val() ? undefined : $('#ActiveLightboxesId').val());

            loadLightboxes(i);
        }
        else {
            //not authenticated
            showLightbox(true);
        }
    }
</script>

<script type="text/javascript">
    function initLightboxes() {
        $('.lightbox-submit').toggleClass('lightbox-display', $('[id$="hfLightboxSubmit"]').val() == 'true');

        if ($('[id$="hfUserName"]').val() == '' && GetQueryString('lbx') == '') {

        }
        else {
            loadLightboxes(null, true);
        }

        $("#divLightboxEmail input").keypress(function (e) {
            if (e.keyCode == 13) {
                checkLightboxAccount();
            }
        });

        $("#divLightboxCreateAccount input").keypress(function (e) {
            if (e.keyCode == 13) {
                createClientPortal();
            }
        });

        $("#divLightboxSignIn input").keypress(function (e) {
            if (e.keyCode == 13) {
                authenticateClientPortal();
            }
        });

        $("#divAeLightbox input").keypress(function (e) {
            if (e.keyCode == 13) {
                createAeLightbox();
            }
        });

        $(".add-lb-contact input").keypress(function (e) {
            if (e.keyCode == 13) {
                saveLightboxContact();
            }
        });
    }

    function validateLightboxAccount() {
        $('#LightboxEmail').val($('#LightboxEmail').val().replace(/ +?/g, ''));
        var v = $('#divLightboxEmail').createValidator();
        return RunValidation(v);
    }

    function checkLightboxAccount() {
        if (validateLightboxAccount()) {
            CallAjax('Contacts_GetUser', { 'collectionsGuid': GetString($('[id$="hfCollectionsGuid"]').val()), 'email': $('#LightboxEmail').val() }, checkLightboxAccountSuccess);
        }
    }

    function checkLightboxAccountSuccess(results) {
        $('#divLightboxEmail').hide();

        if (results.length == 0) {
            $('#spnLightboxEmail').html($('#LightboxEmail').val());
            $('#divLightboxCreateAccount').show();
            $('#LightboxPassword').focus();
            //$('#LightboxFirstName').focus();
        }
        else {
            $('#bEmail').html($('#LightboxEmail').val());
            $('#divLightboxSignIn').show();
            $('#LightboxLoginPassword').focus();
        }
    }

    function validateCreateClientPortal() {
        var rules = {
            LightboxPassword: { minlength: 6 },
            //LightboxConfirmPassword: { minlength: 6, equalTo: "#LightboxPassword" }
        };

        var msgs = {
            LightboxFirstName: { required: 'First Name is required.' },
            LightboxLastName: { required: 'Last Name is required.' },
            LightboxPassword: { required: "Password is required." },
            LightboxConfirmPassword: { required: "Confirm Password is required.", equalTo: "Passwords do not match.", minlength: "Must be at least 6 characters long." }
        };

        var v = $('#divLightboxCreateAccount').createValidator(msgs, rules);
        return RunValidation(v);
    }

    function createClientPortal() {
        if (validateCreateClientPortal()) {
            var l = $('#aCreatePortal').ladda();
            l.ladda('start');
            CallAjax('Contacts_SaveUser', { 'collectionsGuid': GetString($('[id$="hfCollectionsGuid"]').val()), 'email': $('#LightboxEmail').val(), 'firstName': '', 'lastName': '', 'password': $('#LightboxPassword').val(), purpose: 'lightbox' }, createClientPortalSuccess);
        }
    }

    function createClientPortalSuccess(results) {
        if (results.Authenticated) {
            window.location = window.location.href;
        }
        else {
            var l = $('#aCreatePortal').ladda();
            l.ladda('stop');

            alert('There was an error creating your account');
        }
    }

    function validateAuthenticateClientPortal() {
        $('#LightboxEmail').val($('#LightboxEmail').val().replace(/ +?/g, ''));
        var v = $('#divLightboxSignIn').createValidator();
        return RunValidation(v);
    }

    function authenticateClientPortal() {
        if (validateAuthenticateClientPortal()) {
            var l = $('#aSignIn').ladda();
            l.ladda('start');
            CallAjax('Contacts_Login', { 'collectionsGuid': GetString($('[id$="hfCollectionsGuid"]').val()), 'email': $('#LightboxEmail').val(), 'password': $('#LightboxLoginPassword').val(), purpose: 'lightbox' }, authenticateClientPortalSuccess);
        }
    }

    function authenticateClientPortalSuccess(results) {
        if (results.Authenticated) {
            window.location = window.location.href;
        }
        else {
            Ladda.stopAll();
            $('#LightboxLoginPassword').val(''); //reset
            alert('Login Failed');
        }
    }

    function showLightbox(reset) {
        //console.log('showLightbox');
        var l = $('#aCreatePortal').ladda();
        l.ladda('stop');

        if (reset) {
            $('[id$="hfUserName"]').val('');
        }

        var authenticated = false;
        if ($('[id$="hfUserName"]').val() == '') {
            $('.lightbox-modal').show();
            $('#divLightboxScreen').hide();
            $('#divLightboxScreen .lightbox-frame').hide();

            $('#LightboxEmail').val($('[id$="hfLightboxEmail"]').val());
            $('#divLightboxEmail').show();
            $('#divAssociatedLists').hide();
            //$('#LightboxEmail').focus();//bad for mobile
            $('#divLightboxSignIn').hide();
            $('#divLightboxCreateAccount').hide();

            $('#LightboxEmail').html(''); //reset
            $('#LightboxEmail').focus();
        }
        else {
            //$('#divLightbox').show().appendTo($('#divHeader'));
            $('#divLightboxScreen').show();
            //$('#divLightbox').show().insertAfter($('#menu'));

            $('.lightbox-modal').hide();
            $('#divLightboxScreen .lightbox-frame').show();
            authenticated = true;
        }

        stopScrolling();
        return authenticated;
    }

    function closeLightbox() {
        $('#divLightboxScreen').hide();
        startScrolling();
    }
</script>



</div>

        

        

        <div id="divPinForm" class="gallery-modal" style="display: none;" bis_skin_checked="1">
            <div class="gallery-modal-container" bis_skin_checked="1">
                <div id="divPinRequired" bis_skin_checked="1">
                    <div class="client-modal-illustration" bis_skin_checked="1">
                        <i class="far fa-lock-alt"></i>
                    </div>

                    <div class="client-modal-instructions" bis_skin_checked="1">
                        <h5> Download Pin Required</h5>
                        <p>Images in this gallery require a PIN for download. Enter your PIN below</p>

                        <div class="form-group" bis_skin_checked="1">
                            <input type="text" id="PinFormPin" name="PinFormPin" class="required" placeholder="Enter Pin"> <span id="spnPinFormError" style="color: rgb(255, 0, 0); font-size: 12px; text-align: left; display: block; --darkreader-inline-color: var(--darkreader-text-ff0000, #ff1a1a);" data-darkreader-inline-color=""></span>
                        </div>

                        <div class="buttons" bis_skin_checked="1">
                            <div bis_skin_checked="1"><a href="https://57906.lightfolio.com/gallery/tazas-endiabladas-con-teco/grODNb0A#" class="cancel" onclick="closeModal(this); return false;">Cancel</a></div>
                            <div bis_skin_checked="1"><a href="https://57906.lightfolio.com/gallery/tazas-endiabladas-con-teco/grODNb0A#" class="submit" onclick="savePin(); return false;">Submit</a></div>                              
                        </div>
                    </div>                    
                </div>

                <div id="divPinConfirmed" style="display: none;" bis_skin_checked="1">
                    <div class="client-modal-illustration" bis_skin_checked="1">
                        <i class="far fa-thumbs-up"></i>
                    </div>

                    <div class="client-modal-instructions" bis_skin_checked="1">
                        <h5>PIN confirmed</h5>
                        <p>You have submitted a valid PIN.  Click Close to continue to the gallery.</p>

                        <div class="buttons" bis_skin_checked="1">
                            <a href="https://57906.lightfolio.com/gallery/tazas-endiabladas-con-teco/grODNb0A#" class="submit submit-close" onclick="closeModal(this); return false;">Close</a>
                        </div>
                    </div>
                </div>

                <div id="divPinClientsOnly" style="display: none;" bis_skin_checked="1">
                    <div class="client-modal-illustration" bis_skin_checked="1">
                        <i class="far fa-lock-alt"></i>
                    </div>

                    <div class="client-modal-instructions" bis_skin_checked="1">
                        <h5>Clients only</h5>
                        <p>Downloads in this gallery are restricted to clients only.  <a id="aClientLoginLink" href="https://57906.lightfolio.com/gallery/tazas-endiabladas-con-teco/grODNb0A#">Click here</a> to log in.</p>

                        <div class="buttons" bis_skin_checked="1">
                            <a href="https://57906.lightfolio.com/gallery/tazas-endiabladas-con-teco/grODNb0A#" class="submit submit-close" onclick="closeModal(this); return false;">Close</a>
                        </div>
                    </div>
                </div>

                <div id="divPinDisabled" style="display: none;" bis_skin_checked="1">
                    <h5 class="client-modal-header">
                        Downloads Disabled
                    </h5>

                    <div class="client-modal-instructions" bis_skin_checked="1">
                        <p>Downloads are not permitted in this gallery.</p>

                        <div class="buttons" bis_skin_checked="1">
                            <a href="https://57906.lightfolio.com/gallery/tazas-endiabladas-con-teco/grODNb0A#" class="submit submit-close" onclick="closeModal(this); return false;">Close</a>
                        </div>
                    </div>                    
                </div>
            </div>
        </div>

        <script type="text/javascript">
            var vPinForm;
            function validatePinForm(){
                vPinForm = $('#divPinRequired').createValidator();
                return RunValidation(vPinForm);
            }

            function savePin(){
                $('#spnPinFormError').html(''); //reset

                if(validatePinForm())
                    CallAjax('CollectionProperties_ValidatePin', {'collectionsGuid': $('[id$="hfCollectionsGuid"]').val(), 'galleriesGuid': $('[id$="hfFoldersGuid"]').val(), 'downloadPin': $('#PinFormPin').val()}, savePinSuccess);
            }

            function savePinSuccess(results){
                $('#divPinForm .centered-box').hide();

                switch(results.Status){
                    case 'valid':
                    case 'valid pin':
                        $('#divPinRequired').hide().clearForm();
                        $('[id$="hfPinStatus"]').val('pin valid');

                        if ($('#AfterPinAction').val() == 'GalleryDownload') {
                            closePinForm();
                            showDownloadGallery();
                        }
                        else if ($('#AfterPinAction').val() == 'SpecificDownload') {
                            closePinForm();
                            showDownloadSpecific();
                        }
                        else if ($('#AfterPinAction').val() == '')
                            $('#divPinConfirmed').show();
                        else {
                            closePinForm();
                            downloadImage($('#AfterPinAction').val());
                        }   

                        break;
                    case 'pin required': //invalid pin
                    case 'pin gallery': 
                        $('#divPinRequired').show();
                        $('#spnPinFormError').html('Invalid PIN');
                        break;
                    case 'login required': //client login required
                        showPinLoginRequired();
                        break;
                    default: //downloads disabled
                        $('#divPinRequired').hide().clearForm();
                        $('#divPinDisabled').show();                         
                        break;
                }

                $('#AfterPinAction').val(''); //clear
            }

            function showPinForm() {
                if (vPinForm)
                    vPinForm.resetForm();

                Ladda.stopAll();

                $('[id$="pnlDownloads"]').hide();
                $('#divPinRequired').show().clearForm();
                $('#divPinConfirmed').hide();
                $('#divPinDisabled').hide();
                $('#divPinClientsOnly').hide();

                $('#divPinForm').show();
                //$('#PinFormPin').focus(); //bad for mobile?
            }

            function showPinLoginRequired() {
                if (vPinForm)
                    vPinForm.resetForm();

                //$('[id$="pnlDownloads"]').hide();
                $('#divPinForm').show();
                $('#divPinRequired').hide().clearForm();
                $('#divPinClientsOnly').show();  
                $('#aClientLoginLink').attr('href', getCollectionBasePath() + 'login');
            }

            function closePinForm(){
                $('#divPinForm').hide();
            }
        </script>

        <input type="hidden" id="AfterPinAction">
        <input type="hidden" name="hfPinStatus" id="hfPinStatus" value="pin not required">

