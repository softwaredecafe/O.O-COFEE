                            <div class="ctrl">
                                {{#compare ContactsId "==" ''}}
                                <a href="#" onclick="deleteLightboxComment('{{ImageCommentsId}}'); return false;"><i class="fa fa-trash-alt"></i></a>
                                {{/compare}}
                            </div>
                        </li>
                        {{/Items}}
                        {{^Items}}
                        No comments yet.
                        {{/Items}}
                    {{/Comms}}
                </script> 

                <script type="text/javascript">
                    function bindLightboxComments() {
                        //CallAjax('ImageComments_GetByFolder', { foldersId: activeLightbox }, bindLightboxCommentsSuccess);
                        CallAjax('FolderImageActivities_GetComments', { collectionsGuid: $('[id$="hfCollectionsGuid"]').val(), folderImagesId: thisFiid }, bindLightboxCommentsSuccess);
                    }

                    function bindLightboxCommentsSuccess(results) {
                        var source = $("#comments-template").html(); //from gallery
                        var template = Handlebars.compile(source);
                        var data = {items: results};
                        $(".lightbox-comments-list").html(template(data));
                        $('.lightbox-comments-content').show();

                        $(".lightbox-comments-list").find('.add').remove();

                        //$(".modal-right-comments").animate({ scrollTop: 0 }, "fast");
                    }

                    function saveLightboxComment() {
                        var comments = $('.comment-area:visible').val().trim();
                        if (comments != '') {
                            //CallAjax('ImageComments_SaveFolder', { foldersId: activeLightbox, comments: comments }, saveLightboxCommentSuccess);
                            CallAjax('FolderImageActivities_SaveComments', { collectionsGuid: $('[id$="hfCollectionsGuid"]').val(), folderImagesId: thisFiid, comments: comments, description: '' }, saveLightboxCommentSuccess);
                        }
                    }

                    function saveLightboxCommentSuccess(results) {
                        bindLightboxComments();
                        $('.comment-area').val(''); //reset

                        //if (obj.NumComments > 0) {
                        //    div.find('.details-selected .details-comment span').html(obj.NumComments);
                        //    //$('#spnLikeCount').html(obj.NumLikes).show();
                        //    div.find('.details-selected .details-comment').addClass('value');
                        //}
                        //else {
                        //    //$('#spnLikeCount').html('').hide();
                        //    div.find('.details-selected .details-comment span').html('');
                        //    div.find('.details-selected .details-comment').removeClass('value');
                        //}

                        //div.find('.stats-comment').toggleClass('value', obj.NumComments > 0);
                    }
                </script>

